// Модуль HTTP-сервиса GT_Data — чтение данных информационной базы.
//
// Правила, общие для всех обработчиков:
//   • ответ всегда JSON в UTF-8;
//   • отказ ВНУТРИ базы (негодный запрос, нет объекта, ошибка исполнения) отдаётся
//     кодом 200 и объектом {"ok": Ложь, ...}. Код 404 зарезервирован под «расширение
//     не установлено» и опознаётся сервером именно так, поэтому здесь не возвращается;
//   • ни один обработчик не изменяет данные: сервис только читает.

#Область ПрограммныйИнтерфейс

// Проба живости. Сервер зовёт её первой и по ней же сверяет версию расширения.
Функция VersionGet(Запрос) Экспорт
	Данные = Новый Структура;
	Данные.Вставить("продукт", "gt-data-1c");
	Данные.Вставить("расширение", ВерсияРасширения());
	Данные.Вставить("платформа", СтрокаПлатформы());
	Возврат Успех(Данные);
КонецФункции

// Паспорт базы: с какой конфигурацией имеем дело.
Функция BaseGet(Запрос) Экспорт
	Данные = Новый Структура;
	Данные.Вставить("конфигурация", Метаданные.Имя);
	Данные.Вставить("синоним", Метаданные.Синоним);
	Данные.Вставить("версия", Метаданные.Версия);
	Данные.Вставить("поставщик", Метаданные.Поставщик);
	Данные.Вставить("платформа", СтрокаПлатформы());
	Данные.Вставить("режимСовместимости", Строка(Метаданные.РежимСовместимости));
	Возврат Успех(Данные);
КонецФункции

// Состав конфигурации. Без фильтра — сводка по категориям, с фильтром — объекты категории.
//
// Сводка отдаётся именно потому, что полный перечень объектов типовой конфигурации
// не помещается ни в один разумный ответ: вызывающий сначала видит, где сколько,
// и только потом просит нужную категорию.
Функция MetadataGet(Запрос) Экспорт
	Фильтр = ПараметрЗапроса(Запрос, "filter");
	Категории = КатегорииМетаданных();

	Если ПустаяСтрока(Фильтр) Тогда
		Сводка = Новый Массив;
		Для Каждого Категория Из Категории Цикл
			Строка = Новый Структура;
			Строка.Вставить("категория", Категория.Ключ);
			Строка.Вставить("количество", Категория.Значение.Количество());
			Сводка.Добавить(Строка);
		КонецЦикла;
		Данные = Новый Структура;
		Данные.Вставить("категории", Сводка);
		Возврат Успех(Данные);
	КонецЕсли;

	Если Не Категории.Свойство(Фильтр) Тогда
		Известные = Новый Массив;
		Для Каждого Категория Из Категории Цикл
			Известные.Добавить(Категория.Ключ);
		КонецЦикла;
		Возврат Отказ("Категория метаданных не найдена",
			"filter=" + Фильтр + "; известны: " + СтрСоединить(Известные, ", "));
	КонецЕсли;

	Объекты = Новый Массив;
	Для Каждого ОбъектМД Из Категории[Фильтр] Цикл
		// Присоединённые файлы — служебная механика БСП, в перечне она только мешает.
		Если СтрЗаканчиваетсяНа(ОбъектМД.Имя, "ПрисоединенныеФайлы") Тогда
			Продолжить;
		КонецЕсли;
		Строка = Новый Структура;
		Строка.Вставить("имя", ОбъектМД.Имя);
		Строка.Вставить("синоним", ОбъектМД.Синоним);
		Объекты.Добавить(Строка);
	КонецЦикла;

	Данные = Новый Структура;
	Данные.Вставить("категория", Фильтр);
	Данные.Вставить("количество", Объекты.Количество());
	Данные.Вставить("объекты", Объекты);
	Возврат Успех(Данные);
КонецФункции

// Структура объекта метаданных: из чего он состоит и какими полями им пользоваться.
Функция ObjectGet(Запрос) Экспорт
	ТипОбъекта = ПараметрЗапроса(Запрос, "type");
	ИмяОбъекта = ПараметрЗапроса(Запрос, "name");

	Если ПустаяСтрока(ТипОбъекта) Или ПустаяСтрока(ИмяОбъекта) Тогда
		Возврат Отказ("Объект не назван", "нужны параметры type и name");
	КонецЕсли;

	Коллекция = КоллекцияПоТипу(ТипОбъекта);
	Если Коллекция = Неопределено Тогда
		Возврат Отказ("Тип объекта не распознан", "type=" + ТипОбъекта);
	КонецЕсли;

	ОбъектМД = Коллекция.Найти(ИмяОбъекта);
	Если ОбъектМД = Неопределено Тогда
		Возврат Отказ("Объект метаданных не найден",
			ТипОбъекта + "." + ИмяОбъекта + " — в этой конфигурации такого нет");
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("тип", ТипОбъекта);
	Данные.Вставить("имя", ОбъектМД.Имя);
	Данные.Вставить("синоним", ОбъектМД.Синоним);
	Данные.Вставить("полноеИмя", ОбъектМД.ПолноеИмя());

	ДобавитьЕслиЕсть(Данные, "стандартныеПоля", СтандартныеПоля(ОбъектМД));
	ДобавитьЕслиЕсть(Данные, "особенностиРегистраБухгалтерии",
		ОсобенностиРегистраБухгалтерии(ОбъектМД, ТипОбъекта));
	ДобавитьЕслиЕсть(Данные, "реквизиты", ОписаниеПолей(ОбъектМД, "Реквизиты"));
	ДобавитьЕслиЕсть(Данные, "измерения", ОписаниеПолей(ОбъектМД, "Измерения"));
	ДобавитьЕслиЕсть(Данные, "ресурсы", ОписаниеПолей(ОбъектМД, "Ресурсы"));
	ДобавитьЕслиЕсть(Данные, "виртуальныеТаблицы", ВиртуальныеТаблицыРегистра(ОбъектМД, ТипОбъекта));
	ДобавитьЕслиЕсть(Данные, "табличныеЧасти", ОписаниеТабличныхЧастей(ОбъектМД));
	ДобавитьЕслиЕсть(Данные, "значения", ЗначенияПеречисления(ОбъектМД));
	Если ТипОбъекта = "DefinedType" Тогда
		ДобавитьЕслиЕсть(Данные, "типы", СоставОпределяемогоТипа(ОбъектМД));
	КонецЕсли;
	Если ТипОбъекта = "Subsystem" Тогда
		ДобавитьЕслиЕсть(Данные, "состав", СоставПодсистемы(ОбъектМД));
		ДобавитьЕслиЕсть(Данные, "подсистемы", ВложенныеПодсистемы(ОбъектМД));
	КонецЕсли;

	Возврат Успех(Данные);
КонецФункции

// Разбор текста запроса без исполнения — дешёвая проверка до дорогого вызова.
Функция CheckPost(Запрос) Экспорт
	Тело = ТелоЗапроса(Запрос);
	Если Тело.Отказ Тогда
		Возврат Отказ(Тело.Ошибка, Тело.Подробности);
	КонецЕсли;

	ТекстЗапроса = ПолеТела(Тело.Данные, "query", "");
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат Отказ("Текст запроса пуст", "поле query обязательно");
	КонецЕсли;

	Проверка = ТолькоЧтение(ТекстЗапроса);
	Если Проверка.Отказ Тогда
		Возврат Отказ(Проверка.Ошибка, Проверка.Подробности);
	КонецЕсли;

	Попытка
		// Схема запроса разбирает текст, не обращаясь к данным. Выполнить() здесь был бы
		// подменой: проверка стоила бы столько же, сколько сам запрос, ради которого её зовут.
		Схема = Новый СхемаЗапроса;
		Схема.УстановитьТекстЗапроса(ТекстЗапроса);
		Поля = Новый Массив;
		// Колонки берутся у ПОСЛЕДНЕГО запроса выбора пакета: результат пакета — это он,
		// а не первый (первым обычно идёт ПОМЕСТИТЬ во временную таблицу). УНИЧТОЖИТЬ
		// в хвосте пропускается: колонок у него нет.
		Для Номер = -Схема.ПакетЗапросов.Количество() По -1 Цикл
			ЗапросПакета = Схема.ПакетЗапросов[-Номер - 1];
			Если Не ЕстьСвойство(ЗапросПакета, "Колонки") Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Колонка Из ЗапросПакета.Колонки Цикл
				// У колонки схемы имя поля называется псевдонимом — свойства «Имя» у неё нет.
				Поля.Добавить(Колонка.Псевдоним);
			КонецЦикла;
			Прервать;
		КонецЦикла;
	Исключение
		Возврат Отказ("Запрос не разобран", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Данные = Новый Структура;
	Данные.Вставить("разобран", Истина);
	Данные.Вставить("колонки", Поля);
	Возврат Успех(Данные);
КонецФункции

// Выполнение запроса на языке 1С. Только чтение: любой глагол изменения отклоняется
// до обращения к базе.
Функция QueryPost(Запрос) Экспорт
	Тело = ТелоЗапроса(Запрос);
	Если Тело.Отказ Тогда
		Возврат Отказ(Тело.Ошибка, Тело.Подробности);
	КонецЕсли;

	ТекстЗапроса = ПолеТела(Тело.Данные, "query", "");
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат Отказ("Текст запроса пуст", "поле query обязательно");
	КонецЕсли;

	Проверка = ТолькоЧтение(ТекстЗапроса);
	Если Проверка.Отказ Тогда
		Возврат Отказ(Проверка.Ошибка, Проверка.Подробности);
	КонецЕсли;

	Предел = ЧислоИзТела(Тело.Данные, "limit", 100);
	Возврат ВыполнитьЗапросИОтветить(ТекстЗапроса, ПараметрыИзТела(Тело.Данные), Предел,
		ЧислоИзТела(Тело.Данные, "offset", 0));
КонецФункции

// Число записей таблицы с отбором. Текст собирается здесь, чтобы вызывающему
// не приходилось сочинять запрос ради одной цифры.
Функция RecordsPost(Запрос) Экспорт
	Тело = ТелоЗапроса(Запрос);
	Если Тело.Отказ Тогда
		Возврат Отказ(Тело.Ошибка, Тело.Подробности);
	КонецЕсли;

	Таблица = ПолеТела(Тело.Данные, "table", "");
	Если ПустаяСтрока(Таблица) Тогда
		Возврат Отказ("Таблица не названа", "поле table обязательно");
	КонецЕсли;

	Условие = ПолеТела(Тело.Данные, "where", "");

	ТекстЗапроса = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Записей ИЗ " + Таблица;
	Если Не ПустаяСтрока(Условие) Тогда
		ТекстЗапроса = ТекстЗапроса + " ГДЕ " + Условие;
	КонецЕсли;

	Попытка
		ЗапросОбъект = Новый Запрос(ТекстЗапроса);
		ЗаполнитьПараметры(ЗапросОбъект, ПараметрыИзТела(Тело.Данные));
		Выборка = ЗапросОбъект.Выполнить().Выбрать();
		Количество = ?(Выборка.Следующий(), Выборка.Записей, 0);
	Исключение
		Возврат Отказ("Подсчёт не выполнен", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Данные = Новый Структура;
	Данные.Вставить("таблица", Таблица);
	Данные.Вставить("отбор", Условие);
	Данные.Вставить("записей", Количество);
	Возврат Успех(Данные);
КонецФункции

// Итоги регистра накопления через виртуальные таблицы.
//
// Имя виртуальной таблицы и порядок границ периода собираются здесь намеренно:
// именно на них чаще всего ошибаются, а ошибка даёт правдоподобное число.
Функция RegisterPost(Запрос) Экспорт
	Тело = ТелоЗапроса(Запрос);
	Если Тело.Отказ Тогда
		Возврат Отказ(Тело.Ошибка, Тело.Подробности);
	КонецЕсли;

	ИмяРегистра = ПолеТела(Тело.Данные, "register", "");
	Если ПустаяСтрока(ИмяРегистра) Тогда
		Возврат Отказ("Регистр не назван", "поле register обязательно");
	КонецЕсли;

	// Имя принимается и с префиксом вида «РегистрНакопления.Товары» или
	// «РегистрБухгалтерии.Хозрасчетный.Остатки»: берётся второй сегмент.
	ЧастиИмени = СтрРазделить(ИмяРегистра, ".", Ложь);
	Если ЧастиИмени.Количество() >= 2 Тогда
		ИмяРегистра = ЧастиИмени[1];
	КонецЕсли;
	МетаданныеРегистра = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	Если МетаданныеРегистра = Неопределено Тогда
		// Чаще всего сюда приходят с регистром бухгалтерии: имя в базе есть, инструмент
		// не тот. Отказ «не найден» здесь уводит, отказ с адресом — возвращает.
		Если Метаданные.РегистрыБухгалтерии.Найти(ИмяРегистра) <> Неопределено Тогда
			Возврат Отказ("Это регистр бухгалтерии, а не накопления",
				"РегистрБухгалтерии." + ИмяРегистра + " — остатки и обороты по счетам отдаёт инструмент accounts"
				+ " (account, kind, period или start/end), инструмент register его не читает");
		КонецЕсли;
		Возврат Отказ("Регистр накопления не найден",
			"РегистрНакопления." + ИмяРегистра + " — в этой конфигурации такого нет");
	КонецЕсли;

	Вид = ПолеТела(Тело.Данные, "kind", "Остатки");
	Если Вид <> "Остатки" И Вид <> "Обороты" И Вид <> "ОстаткиИОбороты" Тогда
		Возврат Отказ("Вид итогов не распознан",
			"kind=" + Вид + "; допустимо: Остатки, Обороты, ОстаткиИОбороты");
	КонецЕсли;

	Разрезы = МассивИзТела(Тело.Данные, "dimensions");
	Показатели = МассивИзТела(Тело.Данные, "resources");
	Если Показатели.Количество() = 0 Тогда
		Возврат Отказ("Показатели не названы",
			"поле resources пусто; имена ресурсов виртуальной таблицы отличаются от имён "
			+ "регистра (ВНаличии → ВНаличииОстаток) и берутся из метода object");
	КонецЕсли;

	Сборка = ТекстЗапросаПоРегистру(ИмяРегистра, Вид, Разрезы, Показатели, Тело.Данные);
	Если Сборка.Отказ Тогда
		Возврат Отказ(Сборка.Ошибка, Сборка.Подробности);
	КонецЕсли;

	Параметры = ПараметрыИзТела(Тело.Данные);
	Для Каждого Параметр Из Сборка.Параметры Цикл
		Параметры.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;

	Предел = ЧислоИзТела(Тело.Данные, "limit", 100);
	Возврат ВыполнитьЗапросИОтветить(Сборка.Текст, Параметры, Предел,
		ЧислоИзТела(Тело.Данные, "offset", 0));
КонецФункции

// Срез последних регистра сведений — значение, действующее на дату.
//
// Отдельный метод, а не запрос руками: срез легко перепутать с выборкой записей,
// и тогда вместо действующей цены приходит первая попавшаяся строка истории.
Функция SlicePost(Запрос) Экспорт
	Тело = ТелоЗапроса(Запрос);
	Если Тело.Отказ Тогда
		Возврат Отказ(Тело.Ошибка, Тело.Подробности);
	КонецЕсли;

	ИмяРегистра = ПолеТела(Тело.Данные, "register", "");
	Если ПустаяСтрока(ИмяРегистра) Тогда
		Возврат Отказ("Регистр не назван", "поле register обязательно");
	КонецЕсли;

	МетаданныеРегистра = Метаданные.РегистрыСведений.Найти(ИмяРегистра);
	Если МетаданныеРегистра = Неопределено Тогда
		Возврат Отказ("Регистр сведений не найден",
			"РегистрСведений." + ИмяРегистра + " — в этой конфигурации такого нет");
	КонецЕсли;

	Вид = ПолеТела(Тело.Данные, "kind", "СрезПоследних");
	Если Вид <> "СрезПоследних" И Вид <> "СрезПервых" Тогда
		Возврат Отказ("Вид среза не распознан",
			"kind=" + Вид + "; допустимо: СрезПоследних, СрезПервых");
	КонецЕсли;

	Если МетаданныеРегистра.ПериодичностьРегистраСведений
		= Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
		Возврат Отказ("Регистр непериодический",
			"у РегистрСведений." + ИмяРегистра + " нет измерения времени: "
			+ "среза у него не бывает, читайте записи обычным запросом");
	КонецЕсли;

	Поля = Новый Массив;
	Для Каждого Измерение Из МетаданныеРегистра.Измерения Цикл
		Поля.Добавить("Срез." + Измерение.Имя + " КАК " + Измерение.Имя);
	КонецЦикла;
	Для Каждого Ресурс Из МетаданныеРегистра.Ресурсы Цикл
		Поля.Добавить("Срез." + Ресурс.Имя + " КАК " + Ресурс.Имя);
	КонецЦикла;
	Поля.Добавить("Срез.Период КАК Период");

	Параметры = ПараметрыИзТела(Тело.Данные);
	Аргументы = "";
	Период = ДатаИзТела(Тело.Данные, "period");
	Если ЗначениеЗаполнено(Период) Тогда
		Аргументы = "&Период";
		Параметры.Вставить("Период", Период);
	КонецЕсли;

	Условие = ПолеТела(Тело.Данные, "where", "");
	Если Не ПустаяСтрока(Условие) Тогда
		Аргументы = Аргументы + ?(ПустаяСтрока(Аргументы), ", ", ", ") + Условие;
	КонецЕсли;

	Текст = "ВЫБРАТЬ " + СтрСоединить(Поля, ", ")
		+ " ИЗ РегистрСведений." + ИмяРегистра + "." + Вид + "(" + Аргументы + ") КАК Срез";

	Возврат ВыполнитьЗапросИОтветить(Текст, Параметры, ЧислоИзТела(Тело.Данные, "limit", 100),
		ЧислоИзТела(Тело.Данные, "offset", 0));
КонецФункции

// Итоги регистра бухгалтерии по счетам: остатки, обороты или и то и другое.
//
// Отдельно от регистров накопления, потому что устроено иначе: счёт задаётся кодом,
// а суммы делятся на дебет и кредит. Собранный руками запрос здесь ошибается чаще всего.
Функция AccountsPost(Запрос) Экспорт
	Тело = ТелоЗапроса(Запрос);
	Если Тело.Отказ Тогда
		Возврат Отказ(Тело.Ошибка, Тело.Подробности);
	КонецЕсли;

	ИмяРегистра = ПолеТела(Тело.Данные, "register", "Хозрасчетный");
	МетаданныеРегистра = Метаданные.РегистрыБухгалтерии.Найти(ИмяРегистра);
	Если МетаданныеРегистра = Неопределено Тогда
		Возврат Отказ("Регистр бухгалтерии не найден",
			"РегистрБухгалтерии." + ИмяРегистра + " — в этой конфигурации такого нет");
	КонецЕсли;

	Вид = ПолеТела(Тело.Данные, "kind", "Остатки");
	Если Вид <> "Остатки" И Вид <> "Обороты" И Вид <> "ОстаткиИОбороты" Тогда
		Возврат Отказ("Вид итогов не распознан",
			"kind=" + Вид + "; допустимо: Остатки, Обороты, ОстаткиИОбороты");
	КонецЕсли;

	Счёт = ПолеТела(Тело.Данные, "account", "");
	Если ПустаяСтрока(Счёт) Тогда
		Возврат Отказ("Счёт не назван",
			"поле account обязательно: код счёта, например 41 или 62.01");
	КонецЕсли;

	ПланСчетов = МетаданныеРегистра.ПланСчетов;
	Если ПланСчетов = Неопределено Тогда
		Возврат Отказ("У регистра нет плана счетов", ИмяРегистра);
	КонецЕсли;

	СсылкаНаСчёт = ПланыСчетов[ПланСчетов.Имя].НайтиПоКоду(Счёт);
	Если Не ЗначениеЗаполнено(СсылкаНаСчёт) Тогда
		Возврат Отказ("Счёт не найден",
			"код " + Счёт + " отсутствует в плане счетов " + ПланСчетов.Имя);
	КонецЕсли;

	Параметры = ПараметрыИзТела(Тело.Данные);
	Параметры.Вставить("Счёт", СсылкаНаСчёт);

	// Второй параметр виртуальной таблицы — УСЛОВИЕ по счёту, а не сам счёт.
	// «В ИЕРАРХИИ» берёт и субсчета: спрашивая 41, обычно хотят весь товар, а не
	// только записи, повешенные прямо на родителя.
	УсловиеСчёта = "Счет В ИЕРАРХИИ(&Счёт)";

	Аргументы = "";
	Периодичность = "";
	Если Вид = "Остатки" Тогда
		Период = ДатаИзТела(Тело.Данные, "period");
		Если ЗначениеЗаполнено(Период) Тогда
			Параметры.Вставить("Период", Период);
			Аргументы = "&Период, " + УсловиеСчёта;
		Иначе
			Аргументы = ", " + УсловиеСчёта;
		КонецЕсли;
	Иначе
		Начало = ДатаИзТела(Тело.Данные, "start");
		Конец = ДатаИзТела(Тело.Данные, "end");
		Если Не ЗначениеЗаполнено(Начало) Или Не ЗначениеЗаполнено(Конец) Тогда
			Возврат Отказ("Период не задан", "для kind=" + Вид + " нужны поля start и end");
		КонецЕсли;
		// Периодичность запрашивается вызывающим: без неё виртуальная таблица отдаёт один
		// итог за период, и помесячную картину (движение резерва, сальдо по месяцам) собрать
		// нечем — приходится писать запрос руками, а это ровно то, от чего инструмент избавляет.
		Периодичность = ПериодичностьИзТела(Тело.Данные, "periodicity");
		Если СтрНачинаетсяС(Периодичность, "?") Тогда
			Возврат Отказ("Периодичность не распознана: " + Сред(Периодичность, 2),
				"допустимо: День, Неделя, Декада, Месяц, Квартал, Полугодие, Год, Регистратор, Период, Авто");
		КонецЕсли;

		// Позиция условия у видов РАЗНАЯ, и это не мелочь: у Обороты условие четвёртое, а у
		// ОстаткиИОбороты между периодичностью и условием стоит ещё МетодДополнения. Одна
		// недостающая запятая роняла всю таблицу — платформа отвечала «Неверные параметры, 3».
		Если Вид = "ОстаткиИОбороты" Тогда
			Аргументы = "&Начало, &Конец, " + Периодичность + ", , " + УсловиеСчёта;
		Иначе
			Аргументы = "&Начало, &Конец, " + Периодичность + ", " + УсловиеСчёта;
		КонецЕсли;
		Параметры.Вставить("Начало", Начало);
		Параметры.Вставить("Конец", Конец);
	КонецЕсли;

	Показатели = МассивИзТела(Тело.Данные, "resources");
	Если Показатели.Количество() = 0 Тогда
		Показатели = ПоказателиПоУмолчанию(Вид);
	КонецЕсли;

	Поля = Новый Массив;
	// Период идёт ПЕРВОЙ колонкой, когда задана разбивка: без него помесячные строки читаются
	// вслепую — видно одиннадцать сумм и негде посмотреть, к какому месяцу они относятся.
	// Ровно в этом месте вызывающий начинает считать периоды по порядку строк и ошибается.
	Если ЗначениеЗаполнено(Периодичность) И Периодичность <> "Авто" Тогда
		Поля.Добавить("Итоги.Период КАК Период");
	КонецЕсли;
	Поля.Добавить("Итоги.Счет КАК Счет");
	Для Каждого Показатель Из Показатели Цикл
		Поля.Добавить("Итоги." + Показатель + " КАК " + Показатель);
	КонецЦикла;

	Текст = "ВЫБРАТЬ " + СтрСоединить(Поля, ", ")
		+ " ИЗ РегистрБухгалтерии." + ИмяРегистра + "." + Вид + "(" + Аргументы + ") КАК Итоги";

	Возврат ВыполнитьЗапросИОтветить(Текст, Параметры, ЧислоИзТела(Тело.Данные, "limit", 100),
		ЧислоИзТела(Тело.Данные, "offset", 0));
КонецФункции

// Журнал регистрации: ошибки, действия пользователей, системные события.
Функция EventLogGet(Запрос) Экспорт
	Отбор = Новый Структура;

	Начало = ДатаИзСтроки(ПараметрЗапроса(Запрос, "start"));
	Конец = ДатаИзСтроки(ПараметрЗапроса(Запрос, "end"));
	Если ЗначениеЗаполнено(Начало) Или ЗначениеЗаполнено(Конец) Тогда
		Интервал = Новый Массив;
		Интервал.Добавить(?(ЗначениеЗаполнено(Начало), Начало, '00010101'));
		Интервал.Добавить(?(ЗначениеЗаполнено(Конец), Конец, ТекущаяДатаСеанса()));
		Отбор.Вставить("Дата", Интервал);
	КонецЕсли;

	Уровень = ПараметрЗапроса(Запрос, "level");
	Если Не ПустаяСтрока(Уровень) Тогда
		УровеньЖР = УровеньЖурнала(Уровень);
		Если УровеньЖР = Неопределено Тогда
			Возврат Отказ("Уровень важности не распознан",
				"level=" + Уровень + "; допустимо: Ошибка, Предупреждение, Информация, Примечание");
		КонецЕсли;
		Отбор.Вставить("Уровень", УровеньЖР);
	КонецЕсли;

	Пользователь = ПараметрЗапроса(Запрос, "user");
	Если Не ПустаяСтрока(Пользователь) Тогда
		Отбор.Вставить("Пользователь", Пользователь);
	КонецЕсли;

	Предел = Число(?(ПустаяСтрока(ПараметрЗапроса(Запрос, "limit")), "50",
		ПараметрЗапроса(Запрос, "limit")));
	Если Предел > 500 Тогда
		Предел = 500;
	КонецЕсли;

	Попытка
		Таблица = Новый ТаблицаЗначений;
		ВыгрузитьЖурналРегистрации(Таблица, Отбор, , , Предел);
	Исключение
		Возврат Отказ("Журнал регистрации не прочитан",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Записи = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Запись = Новый Структура;
		Запись.Вставить("дата", ПредставлениеЗначения(Строка.Дата));
		Запись.Вставить("уровень", Строка(Строка.Уровень));
		Запись.Вставить("пользователь", Строка.ИмяПользователя);
		Запись.Вставить("событие", Строка.ПредставлениеСобытия);
		Запись.Вставить("комментарий", Строка.Комментарий);
		Записи.Добавить(Запись);
	КонецЦикла;

	Данные = Новый Структура;
	Данные.Вставить("записей", Записи.Количество());
	Данные.Вставить("предел", Предел);
	Данные.Вставить("записи", Записи);
	Возврат Успех(Данные);
КонецФункции


// Разбор текста запроса в структуру: что он читает, какими полями и с какими условиями.
//
// Отвечает на другой вопрос, чем check: тот говорит «правилен ли текст», этот — «как он
// устроен». Нужен там, где чужой запрос на сотни строк надо понять целиком, не вычитывая
// его глазами: какие таблицы трогает, что соединяет, чем отбирает, какие параметры ждёт.
Функция QueryParsePost(Запрос) Экспорт
	Тело = ТелоЗапроса(Запрос);
	Если Тело.Отказ Тогда
		Возврат Отказ(Тело.Ошибка, Тело.Подробности);
	КонецЕсли;

	ТекстЗапроса = ПолеТела(Тело.Данные, "query", "");
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат Отказ("Текст запроса пуст", "поле query обязательно");
	КонецЕсли;

	Проверка = ТолькоЧтение(ТекстЗапроса);
	Если Проверка.Отказ Тогда
		Возврат Отказ(Проверка.Ошибка, Проверка.Подробности);
	КонецЕсли;

	Попытка
		Схема = Новый СхемаЗапроса;
		Схема.УстановитьТекстЗапроса(ТекстЗапроса);
	Исключение
		// Тот же отказ, что у check: текст не разобран платформой. Разбирать нечего.
		Возврат Отказ("Запрос не разобран", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Запросы = Новый Массив;
	ВсеТаблицы = Новый Соответствие;
	ВременныеТаблицы = Новый Массив;

	Для Номер = 0 По Схема.ПакетЗапросов.Количество() - 1 Цикл
		ЗапросПакета = Схема.ПакетЗапросов[Номер];
		Описание = ОписаниеЗапросаПакета(ЗапросПакета, Номер, ВсеТаблицы, ВременныеТаблицы);
		Запросы.Добавить(Описание);
	КонецЦикла;

	// Параметры собираются схемой по всему пакету разом — обходить запросы не нужно.
	// Заказали итоги — они обязаны быть в тексте. Платформа выбрасывает секцию ИТОГИ
	// без ошибки, если ей не за что зацепиться, и тогда наружу уходит складный запрос
	// без итоговой строки. Тихая потеря хуже отказа: отказ виден, а недостающий итог
	// замечают уже в отчёте.
	Если МассивИзТела(Тело.Данные, "итоги").Количество() > 0
		И СтрНайти(ВРег(ТекстЗапроса), "ИТОГИ") = 0 Тогда
		Возврат Отказ("Итоги не попали в запрос",
			"платформа отбросила секцию ИТОГИ. Обычная причина — итожимое поле отсутствует"
			+ " в списке выборки или названо иначе; укажите в expr псевдоним колонки из select");
	КонецЕсли;

	Параметры = Новый Массив;
	Попытка
		Для Каждого Пар Из Схема.НайтиПараметры() Цикл
			Параметры.Добавить(Пар.Имя);
		КонецЦикла;
	Исключение
		// Не повод ронять разбор: параметров может не быть вовсе.
	КонецПопытки;

	Таблицы = Новый Массив;
	Для Каждого Эл Из ВсеТаблицы Цикл
		Таблицы.Добавить(Эл.Ключ);
	КонецЦикла;

	Данные = Новый Структура;
	Данные.Вставить("разобран", Истина);
	Данные.Вставить("запросовВПакете", Схема.ПакетЗапросов.Количество());
	Данные.Вставить("таблицы", Таблицы);
	Данные.Вставить("временныеТаблицы", ВременныеТаблицы);
	Данные.Вставить("параметры", Параметры);
	Данные.Вставить("запросы", Запросы);
	Возврат Успех(Данные);
КонецФункции



// Сборка текста запроса из структуры. Обратный ход к parse.
//
// Смысл не в экономии печати, а в том, ГДЕ ловится ошибка: схема проверяет имя таблицы и
// поля в момент добавления в неё, то есть до того, как из них сложится текст. Вызывающий
// получает «Поле не найдено "Н.ТакогоПоляНет"» с указанием места вместо запроса, который
// выглядит правдоподобно и отказывает при исполнении. Синтаксис при этом пишет платформа:
// запятых, скобок и порядка секций в структуре нет вовсе, поэтому ошибиться в них нельзя.
Функция QueryBuildPost(Запрос) Экспорт
	Тело = ТелоЗапроса(Запрос);
	Если Тело.Отказ Тогда
		Возврат Отказ(Тело.Ошибка, Тело.Подробности);
	КонецЕсли;

	Источник = ПолеТела(Тело.Данные, "источник", "");
	Если ПустаяСтрока(Источник) Тогда
		Источник = ПолеТела(Тело.Данные, "source", "");
	КонецЕсли;
	Если ПустаяСтрока(Источник) Тогда
		Возврат Отказ("Источник не назван",
			"поле «источник» обязательно: имя таблицы вида Справочник.Номенклатура,"
			+ " Документ.РеализацияТоваровУслуг.Товары или"
			+ " РегистрНакопления.ТоварыНаСкладах.Остатки");
	КонецЕсли;

	Поля = МассивИзТела(Тело.Данные, "поля");
	Если Поля.Количество() = 0 Тогда
		Возврат Отказ("Поля не заданы",
			"поле «поля» обязательно: массив имён или объектов {функция, поле, как}");
	КонецЕсли;

	Псевдоним = ПолеТела(Тело.Данные, "псевдоним", "");
	Если ПустаяСтрока(Псевдоним) Тогда
		// Псевдоним нужен всегда: без него поля пришлось бы писать полным именем таблицы,
		// а вызывающий уже написал их коротко.
		Псевдоним = ПсевдонимПоУмолчанию(Источник);
	КонецЕсли;

	Схема = Новый СхемаЗапроса;
	ЗапросВыбора = Схема.ПакетЗапросов[0];
	Оператор = ЗапросВыбора.Операторы[0];

	// Псевдонимы всех источников запроса. Пока источник один, хватало основного; с
	// соединениями поле «Контрагенты.Наименование» уже принадлежит другой таблице, и
	// дополнять его псевдонимом основной — значит собрать «Док.Контрагенты.Наименование».
	ПсевдонимыЗапроса = Новый Массив;
	ПсевдонимыЗапроса.Добавить(Псевдоним);

	// Источник добавляется первым: пока его нет, схема не знает ни одного поля и отвергнет
	// любое, даже верное.
	Попытка
		ИсточникСхемы = Оператор.Источники.Добавить(Источник, Псевдоним);
	Исключение
		Возврат ОтказСборки("Источник не принят", Источник,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// Параметры виртуальной таблицы. В Добавить их вписать нельзя — имя со скобками
	// отвергается как неизвестная таблица, поэтому они выставляются после, по позициям.
	// Массив, а не строка: у таблицы Остатки один параметр-период и один параметр-условие,
	// и позиция в массиве соответствует позиции в скобках.
	ПараметрыТаблицы = МассивИзТела(Тело.Данные, "параметрыТаблицы");
	Если ПараметрыТаблицы.Количество() > 0 Тогда
		ДоступноПараметров = ИсточникСхемы.Источник.Параметры.Количество();
		Если ПараметрыТаблицы.Количество() > ДоступноПараметров Тогда
			Возврат Отказ("Лишние параметры таблицы",
				"таблица " + Источник + " принимает параметров: " + ДоступноПараметров
				+ ", передано: " + ПараметрыТаблицы.Количество());
		КонецЕсли;
		Для Номер = 0 По ПараметрыТаблицы.Количество() - 1 Цикл
			Значение = СокрЛП(Строка(ПараметрыТаблицы[Номер]));
			Если ПустаяСтрока(Значение) Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				ИсточникСхемы.Источник.Параметры[Номер].Выражение = Новый ВыражениеСхемыЗапроса(Значение);
			Исключение
				Возврат ОтказСборки("Параметр таблицы не принят", Значение,
					КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;

	// Соединения. Добавляются ДО полей: поле присоединённой таблицы схема примет только
	// когда её источник уже в запросе. Условие соединения пишется целиком с псевдонимами
	// обеих сторон — дополнять его псевдонимом основной таблицы нельзя, оно двустороннее.
	Для Каждого ОписаниеСоединения Из МассивИзТела(Тело.Данные, "соединения") Цикл
		Если ТипЗнч(ОписаниеСоединения) <> Тип("Структура") И ТипЗнч(ОписаниеСоединения) <> Тип("Соответствие") Тогда
			Возврат Отказ("Соединение описано неверно",
				"каждое соединение — объект с полями from (таблица) и on (условие)");
		КонецЕсли;
		ИсточникСоединения = СокрЛП(ПолеТела(ОписаниеСоединения, "источник", ""));
		УсловиеСоединения = СокрЛП(ПолеТела(ОписаниеСоединения, "условие", ""));
		Если ПустаяСтрока(ИсточникСоединения) Тогда
			Возврат Отказ("Соединение без таблицы", "поле from обязательно");
		КонецЕсли;
		Если ПустаяСтрока(УсловиеСоединения) Тогда
			Возврат Отказ("Соединение без условия",
				"поле on обязательно: условие с псевдонимами обеих таблиц, напр. Док.Контрагент = Контрагенты.Ссылка");
		КонецЕсли;
		ПсевдонимСоединения = СокрЛП(ПолеТела(ОписаниеСоединения, "псевдоним", ""));
		Если ПустаяСтрока(ПсевдонимСоединения) Тогда
			ПсевдонимСоединения = ПсевдонимПоУмолчанию(ИсточникСоединения);
		КонецЕсли;

		ПсевдонимыЗапроса.Добавить(ПсевдонимСоединения);
		Попытка
			ДобавленныйИсточник = Оператор.Источники.Добавить(ИсточникСоединения, ПсевдонимСоединения);
		Исключение
			Возврат ОтказСборки("Присоединяемая таблица не принята", ИсточникСоединения,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

		// Параметры виртуальной таблицы присоединяемого источника — по тем же правилам,
		// что и у основного.
		ПараметрыСоединения = МассивИзТела(ОписаниеСоединения, "параметрыТаблицы");
		Если ПараметрыСоединения.Количество() > 0 Тогда
			ДоступноПараметров = ДобавленныйИсточник.Источник.Параметры.Количество();
			Если ПараметрыСоединения.Количество() > ДоступноПараметров Тогда
				Возврат Отказ("Лишние параметры таблицы",
					"таблица " + ИсточникСоединения + " принимает параметров: " + ДоступноПараметров
					+ ", передано: " + ПараметрыСоединения.Количество());
			КонецЕсли;
			Для Номер = 0 По ПараметрыСоединения.Количество() - 1 Цикл
				ЗначениеПараметра = СокрЛП(Строка(ПараметрыСоединения[Номер]));
				Если ПустаяСтрока(ЗначениеПараметра) Тогда
					Продолжить;
				КонецЕсли;
				Попытка
					ДобавленныйИсточник.Источник.Параметры[Номер].Выражение = Новый ВыражениеСхемыЗапроса(ЗначениеПараметра);
				Исключение
					Возврат ОтказСборки("Параметр таблицы не принят", ЗначениеПараметра,
						КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;

		// Связь создаётся ПЛАТФОРМОЙ автоматически при Источники.Добавить: она сама
		// связывает новый источник со всеми полями основной таблицы, ссылающимися на него.
		// Проверено на bu3 31.08.2026: присоединение Справочник.Контрагенты дало условие
		// «Контрагент = К.Ссылка И Грузоотправитель = К.Ссылка И Грузополучатель = ... И
		// Перевозчик = ... И Комиссионер = ...» — пять полей вместо одного. Добавлять свою
		// связь поверх нельзя: она уходит ШЕСТОЙ через И (отсюда «Противоречивая связь» и
		// потерянный тип соединения). Автосвязь ИСПРАВЛЯЕТСЯ — условие и тип заменяются.
		Попытка
			// Автосвязей может быть НЕСКОЛЬКО — по одной на каждое ссылающееся поле, — и
			// правка последней оставляет остальные в запросе (bu3, 31.08.2026: в условии
			// висели Грузоотправитель, Грузополучатель, Перевозчик, Комиссионер). Поэтому
			// коллекция очищается целиком, и заводится ровно та связь, которую заказали.
			ИсточникСхемы.Соединения.Очистить();
			ИсточникСхемы.Соединения.Добавить(ДобавленныйИсточник, УсловиеСоединения);
			ЭлементСоединения = ИсточникСхемы.Соединения[ИсточникСхемы.Соединения.Количество() - 1];
		Исключение
			Возврат ОтказСборки("Условие соединения не принято", УсловиеСоединения,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

		Попытка
			ВидСоединения = НРег(СокрЛП(ПолеТела(ОписаниеСоединения, "тип", "left")));
			Если ВидСоединения = "inner" Тогда
				ЭлементСоединения.ТипСоединения = ТипСоединенияСхемыЗапроса.Внутреннее;
			ИначеЕсли ВидСоединения = "right" Тогда
				ЭлементСоединения.ТипСоединения = ТипСоединенияСхемыЗапроса.ПравоеВнешнее;
			ИначеЕсли ВидСоединения = "full" Тогда
				ЭлементСоединения.ТипСоединения = ТипСоединенияСхемыЗапроса.ПолноеВнешнее;
			Иначе
				ЭлементСоединения.ТипСоединения = ТипСоединенияСхемыЗапроса.ЛевоеВнешнее;
			КонецЕсли;
		Исключение
			Возврат ОтказСборки("Вид соединения не принят",
				ПолеТела(ОписаниеСоединения, "тип", "left"),
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	// Поля. Каждое проверяется схемой в момент добавления, поэтому отказ называет
	// виновное поле, а не запрос целиком. Псевдонимы колонок запоминаются: в группировке
	// вызывающий называет колонку так, как назвал её сам («Период»), а схема ждёт выражение.
	ВыраженияПоПсевдонимам = Новый Соответствие;
	Для Каждого ОписаниеПоля Из Поля Цикл
		Разбор = ВыражениеПоля(ОписаниеПоля, Псевдоним, ПсевдонимыЗапроса);
		Если Разбор.Отказ Тогда
			Возврат Отказ("Поле описано неверно", Разбор.Ошибка);
		КонецЕсли;
		Если Не ПустаяСтрока(Разбор.Псевдоним) Тогда
			ВыраженияПоПсевдонимам.Вставить(ВРег(СокрЛП(Разбор.Псевдоним)), Разбор.Выражение);
		КонецЕсли;

		Попытка
			Оператор.ВыбираемыеПоля.Добавить(Разбор.Выражение);
		Исключение
			Возврат ОтказСборки("Поле не принято", Разбор.Выражение,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

		Если Не ПустаяСтрока(Разбор.Псевдоним) Тогда
			Индекс = ЗапросВыбора.Колонки.Количество() - 1;
			Если Индекс >= 0 Тогда
				ЗапросВыбора.Колонки[Индекс].Псевдоним = Разбор.Псевдоним;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// Отбор, группировка, порядок — необязательные секции.
	Для Каждого Условие Из МассивИзТела(Тело.Данные, "отбор") Цикл
		Попытка
			Оператор.Отбор.Добавить(ДополнитьПсевдонимом(Строка(Условие), Псевдоним, ПсевдонимыЗапроса));
		Исключение
			Возврат ОтказСборки("Условие отбора не принято", Строка(Условие),
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Для Каждого Поле Из МассивИзТела(Тело.Данные, "группировка") Цикл
		Попытка
			ТекстГруппировки = ВыраженияПоПсевдонимам[ВРег(СокрЛП(Строка(Поле)))];
			Если ТекстГруппировки = Неопределено Тогда
				ТекстГруппировки = ДополнитьПсевдонимом(Строка(Поле), Псевдоним, ПсевдонимыЗапроса);
			КонецЕсли;
			Оператор.Группировка.Добавить(ТекстГруппировки);
		Исключение
			Возврат ОтказСборки("Поле группировки не принято", Строка(Поле),
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Для Каждого Поле Из МассивИзТела(Тело.Данные, "порядок") Цикл
		Попытка
			// В порядок идёт ПСЕВДОНИМ колонки результата, а не выражение источника.
			// Направление — хвост «УБЫВ» / «ВОЗР» в строке: в схеме это отдельное свойство
			// элемента, а не часть выражения, и строкой «Сумма УБЫВ» платформа отказывает.
			ТекстПорядка = СокрЛП(Строка(Поле));
			Убывание = Ложь;
			// Направление принимается и по-английски (DESC/ASC), и с частой опечаткой:
			// прогон 31.08.2026 дал «СуммаОборот ОБАЧЬ» — искажённое УБЫВ, стоившее оборота.
			// Хвост, однозначно означающий направление, толкуется, а не роняет запрос;
			// неизвестный хвост по-прежнему уходит в платформу и получает честный отказ.
			ХвостыУбыв = СтрРазделить("УБЫВ,DESC,ОБАЧЬ,УБЫВАНИЕ,УБЫВАЮ,УБЫВАЮЩ", ",", Ложь);
			ХвостыВозр = СтрРазделить("ВОЗР,ASC,ВОЗРАСТАНИЕ,ВОЗРАСТ,ВОЗРАСТАЮЩ", ",", Ложь);
			Для Каждого Хвост Из ХвостыУбыв Цикл
				Если СтрЗаканчиваетсяНа(ВРег(ТекстПорядка), " " + Хвост) Тогда
					ТекстПорядка = СокрЛП(Лев(ТекстПорядка, СтрДлина(ТекстПорядка) - СтрДлина(Хвост) - 1));
					Убывание = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Не Убывание Тогда
				Для Каждого Хвост Из ХвостыВозр Цикл
					Если СтрЗаканчиваетсяНа(ВРег(ТекстПорядка), " " + Хвост) Тогда
						ТекстПорядка = СокрЛП(Лев(ТекстПорядка, СтрДлина(ТекстПорядка) - СтрДлина(Хвост) - 1));
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			ЭлементПорядка = ЗапросВыбора.Порядок.Добавить(ТекстПорядка);
			Если Убывание Тогда
				ЭлементПорядка.Направление = НаправлениеПорядкаСхемыЗапроса.ПоУбыванию;
			КонецЕсли;
		Исключение
			Возврат ОтказСборки("Поле упорядочивания не принято", Строка(Поле),
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	// ИТОГИ. Разрез «по» — отдельным свойством, а не хвостом строки: схема хранит выражение
	// итога и его разрез раздельно, и склеенные в строку они отвергаются целиком.
	Для Каждого ОписаниеИтога Из МассивИзТела(Тело.Данные, "итоги") Цикл
		Если ТипЗнч(ОписаниеИтога) <> Тип("Структура") И ТипЗнч(ОписаниеИтога) <> Тип("Соответствие") Тогда
			Возврат Отказ("Итог описан неверно", "каждый итог — объект с полем expr (выражение)");
		КонецЕсли;
		ВыражениеИтога = СокрЛП(ПолеТела(ОписаниеИтога, "выражение", ""));
		Если ПустаяСтрока(ВыражениеИтога) Тогда
			Возврат Отказ("Итог без выражения", "поле expr обязательно: СУММА(Сумма), КОЛИЧЕСТВО(*)");
		КонецЕсли;
		// Агрегатная обёртка снимается: платформа ждёт в ИТОГИ само поле, а СУММА/КОЛИЧЕСТВО
		// подставляет сама. Запись «СУММА(Док.Сумма)» естественна для вызывающего и означает
		// ровно то, что нужно, — переводим её, а не отвергаем.
		ВыражениеБезАгрегата = БезАгрегатнойОбёртки(ВыражениеИтога);

		// Псевдоним колонки в итоге допустим — переводим его в выражение, как в группировке.
		ПодставленноеВыражение = ВыраженияПоПсевдонимам[ВРег(ВыражениеБезАгрегата)];
		Если ПодставленноеВыражение = Неопределено Тогда
			ПодставленноеВыражение = ДополнитьПсевдонимом(ВыражениеБезАгрегата, Псевдоним, ПсевдонимыЗапроса);
		КонецЕсли;

		// Если итог назван ПСЕВДОНИМОМ колонки, в ИТОГИ идёт сам псевдоним, а не выражение
		// за ним: у агрегированной колонки («СУММА(Док.Сумма) КАК Сумма») развёрнутое
		// выражение платформа не примет, а снятие агрегата даёт голое поле при группировке
		// по другому — и тогда ИТОГИ пропадают из текста МОЛЧА (bu3, 31.08.2026).
		Если ВыраженияПоПсевдонимам[ВРег(ВыражениеБезАгрегата)] <> Неопределено
			И ВыражениеБезАгрегата <> ВыражениеИтога Тогда
			ПодставленноеВыражение = ВыражениеБезАгрегата;
		ИначеЕсли ВыраженияПоПсевдонимам[ВРег(ВыражениеИтога)] <> Неопределено Тогда
			ПодставленноеВыражение = ВыражениеИтога;
		КонецЕсли;
		Попытка
			// ВыраженияИтогов.Добавить — ПРОЦЕДУРА: объект не возвращает (справка,
			// QuerySchemaTotalExpressions.Add). Псевдоним итоговой колонки ставится у
			// последнего добавленного элемента, свойством Поле.
			ЗапросВыбора.ВыраженияИтогов.Добавить(ПодставленноеВыражение);
			ПсевдонимИтога = СокрЛП(ПолеТела(ОписаниеИтога, "как", ""));
			Если Не ПустаяСтрока(ПсевдонимИтога) Тогда
				Попытка
					ИндексИтога = ЗапросВыбора.ВыраженияИтогов.Количество() - 1;
					Если ИндексИтога >= 0 Тогда
						ЗапросВыбора.ВыраженияИтогов[ИндексИтога].Поле = ПсевдонимИтога;
					КонецЕсли;
				Исключение
					// Псевдоним итога необязателен: платформа назовёт колонку сама.
				КонецПопытки;
			КонецЕсли;
		Исключение
			// Самая частая причина здесь одна, и общее правило её не называет: итожимое поле
			// не попало в select. Говорим прямо, что добавить, — иначе вызывающий уходит
			// перебирать формы записи итога.
			Возврат ОтказСборки("Итог не принят", ВыражениеИтога,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
				+ ". Поле итога должно быть в select — без агрегата, например {""field"": """
				+ ВыражениеБезАгрегата + """}");
		КонецПопытки;

		РазрезИтога = СокрЛП(ПолеТела(ОписаниеИтога, "по", ""));

		// «ПО ОБЩИЕ» — не контрольная точка, а отдельное свойство схемы (справка:
		// ЗапросВыбораСхемыЗапроса.ОбщиеИтоги). Без него платформа не находит ни одной
		// точки расчёта и выбрасывает ВСЮ секцию ИТОГИ — молча, без ошибки.
		Если ПустаяСтрока(РазрезИтога) Или ВРег(РазрезИтога) = "ОБЩИЕ" Тогда
			ЗапросВыбора.ОбщиеИтоги = Истина;
		КонецЕсли;

		Если Не ПустаяСтрока(РазрезИтога) И ВРег(РазрезИтога) <> "ОБЩИЕ" Тогда
			ВыражениеРазреза = ВыраженияПоПсевдонимам[ВРег(РазрезИтога)];
			Если ВыражениеРазреза = Неопределено Тогда
				ВыражениеРазреза = ДополнитьПсевдонимом(РазрезИтога, Псевдоним, ПсевдонимыЗапроса);
			КонецЕсли;
			Попытка
				ЗапросВыбора.КонтрольныеТочкиИтогов.Добавить(ВыражениеРазреза);
			Исключение
				Возврат ОтказСборки("Разрез итога не принят", РазрезИтога,
					КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Если ПолеТела(Тело.Данные, "различные", Ложь) = Истина Тогда
		Оператор.ВыбиратьРазличные = Истина;
	КонецЕсли;

	Первые = ЧислоИзТела(Тело.Данные, "первые", 0);
	Если Первые > 0 Тогда
		Оператор.КоличествоПолучаемыхЗаписей = Первые;
	КонецЕсли;

	Попытка
		ТекстЗапроса = Схема.ПолучитьТекстЗапроса();
	Исключение
		Возврат Отказ("Текст не собран", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Параметры = Новый Массив;
	Попытка
		Для Каждого Пар Из Схема.НайтиПараметры() Цикл
			Параметры.Добавить(Пар.Имя);
		КонецЦикла;
	Исключение
		// Параметров может не быть.
	КонецПопытки;

	// Значения параметров, названные вызывающим. Нужны там, где значение нельзя написать
	// текстом условия: код счёта надо превратить в ССЫЛКУ плана счетов, иначе сравнение
	// падает с «нельзя сравнивать поля несовместимых типов» — замер 31.08.2026 поймал три
	// такие попытки подряд. Возвращаются наружу, чтобы query подставил их при выполнении.
	ЗначенияПараметров = Новый Соответствие;
	Для Каждого ОписаниеПараметра Из МассивИзТела(Тело.Данные, "параметры") Цикл
		Если ТипЗнч(ОписаниеПараметра) <> Тип("Структура") И ТипЗнч(ОписаниеПараметра) <> Тип("Соответствие") Тогда
			Возврат Отказ("Параметр описан неверно", "каждый параметр — объект с полем name");
		КонецЕсли;
		ИмяПараметра = СокрЛП(ПолеТела(ОписаниеПараметра, "имя", ""));
		Если ПустаяСтрока(ИмяПараметра) Тогда
			Возврат Отказ("Параметр без имени", "поле name обязательно");
		КонецЕсли;

		КодСчёта = СокрЛП(ПолеТела(ОписаниеПараметра, "счет", ""));
		Если Не ПустаяСтрока(КодСчёта) Тогда
			ПланСчетовРегистра = ПланСчетовИсточника(Источник);
			Если ПланСчетовРегистра = Неопределено Тогда
				Возврат Отказ("Счёт задан не для регистра бухгалтерии",
					"поле account имеет смысл, когда источник — регистр бухгалтерии: " + Источник);
			КонецЕсли;
			СсылкаСчёта = ПланыСчетов[ПланСчетовРегистра].НайтиПоКоду(КодСчёта);
			Если Не ЗначениеЗаполнено(СсылкаСчёта) Тогда
				Возврат Отказ("Счёт не найден",
					"код " + КодСчёта + " отсутствует в плане счетов " + ПланСчетовРегистра);
			КонецЕсли;
			ЗначенияПараметров.Вставить(ИмяПараметра, СсылкаСчёта);
			Продолжить;
		КонецЕсли;

		ОписаниеСсылки = СокрЛП(ПолеТела(ОписаниеПараметра, "ссылка", ""));
		Если Не ПустаяСтрока(ОписаниеСсылки) Тогда
			Попытка
				ЗначенияПараметров.Вставить(ИмяПараметра, ПредопределённоеЗначение(ОписаниеСсылки));
			Исключение
				Возврат ОтказСборки("Ссылка не распознана", ОписаниеСсылки,
					КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
			Продолжить;
		КонецЕсли;

		ЗначенияПараметров.Вставить(ИмяПараметра,
			ЗначениеПараметра(ПолеТела(ОписаниеПараметра, "значение", Неопределено)));
	КонецЦикла;

	Данные = Новый Структура;
	Данные.Вставить("запрос", ТекстЗапроса);
	Данные.Вставить("параметры", Параметры);
	// Значения, вычисленные здесь, обязаны ДОЕХАТЬ до выполнения. Код счёта «51» уже
	// превращён в ссылку плана счетов, но выполняет запрос ОТДЕЛЬНЫЙ вызов query, и если
	// отдать наружу представление («Расчетные счета»), вызывающий подставит в параметр
	// строку. Сравнение строки со ссылкой не падает — оно просто не совпадает никогда, и
	// запрос возвращает НОЛЬ СТРОК, неотличимый от честного «в базе пусто».
	//
	// Ровно это и случилось 31.08.2026 на bu3: accounts по счёту 51 давал обороты, а
	// собранный здесь запрос по тому же счёту — пусто, четырьмя способами подряд, и ни
	// один из них не выглядел ошибкой.
	//
	// Поэтому ссылка отдаётся ОПИСАНИЕМ, которое ЗначениеСсылочногоПараметра разберёт
	// обратно при выполнении, а представление идёт отдельным полем — для человека.
	Если ЗначенияПараметров.Количество() > 0 Тогда
		ЗначенияДляОтвета = Новый Структура;
		ПредставленияДляОтвета = Новый Структура;
		Для Каждого Пара Из ЗначенияПараметров Цикл
			ЗначенияДляОтвета.Вставить(Пара.Ключ, ОписаниеЗначенияПараметра(Пара.Значение));
			ПредставленияДляОтвета.Вставить(Пара.Ключ, Строка(Пара.Значение));
		КонецЦикла;
		Данные.Вставить("значенияПараметров", ЗначенияДляОтвета);
		Данные.Вставить("представленияПараметров", ПредставленияДляОтвета);
	КонецЕсли;
	Возврат Успех(Данные);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции



// БезАгрегатнойОбёртки — «СУММА(Док.Сумма)» -> «Док.Сумма». В конструкции ИТОГИ агрегат
// задаёт сама платформа, поэтому обёртка здесь лишняя; вызывающий же пишет её естественно,
// по образцу выбираемых полей. Снимается только ИЗВЕСТНАЯ обёртка и только когда скобка
// закрывает всё выражение: «СУММА(А) + СУММА(Б)» трогать нельзя.
Функция БезАгрегатнойОбёртки(Выражение)
	Текст = СокрЛП(Выражение);
	Агрегаты = СтрРазделить("СУММА,КОЛИЧЕСТВО,МАКСИМУМ,МИНИМУМ,СРЕДНЕЕ", ",", Ложь);
	Для Каждого Агрегат Из Агрегаты Цикл
		Префикс = Агрегат + "(";
		Если Не СтрНачинаетсяС(ВРег(Текст), Префикс) Или Не СтрЗаканчиваетсяНа(Текст, ")") Тогда
			Продолжить;
		КонецЕсли;
		Внутри = Сред(Текст, СтрДлина(Префикс) + 1, СтрДлина(Текст) - СтрДлина(Префикс) - 1);
		// Скобка должна закрывать ВСЁ выражение: считаем баланс, и если он уходит в ноль
		// раньше конца, обёртка не единственная — оставляем как есть.
		Баланс = 0;
		ЗакрылосьРано = Ложь;
		Для Позиция = 1 По СтрДлина(Внутри) Цикл
			Символ = Сред(Внутри, Позиция, 1);
			Если Символ = "(" Тогда
				Баланс = Баланс + 1;
			ИначеЕсли Символ = ")" Тогда
				Баланс = Баланс - 1;
				Если Баланс < 0 Тогда
					ЗакрылосьРано = Истина;
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если Не ЗакрылосьРано И Баланс = 0 И Не ПустаяСтрока(СокрЛП(Внутри)) И СокрЛП(Внутри) <> "*" Тогда
			Возврат СокрЛП(Внутри);
		КонецЕсли;
	КонецЦикла;
	Возврат Текст;
КонецФункции


// ВиртуальныеТаблицыРегистра — состав полей и параметров каждой виртуальной таблицы регистра,
// именами, которые примет запрос.
//
// Зачем. У виртуальных таблиц имена ДРУГИЕ, чем у основной: Обороты.Счет вместо СчетДт,
// ОборотыДтКт.СуммаОборот вместо СуммаОборотДт. Прежде инструмент описывал это правилом
// («к оборотам добавляется Оборот»), и правило нужно было ПРИМЕНИТЬ — на этом шаге слабая
// модель и ошибалась (прогон 31.08.2026: три отказа из пяти именно тут). Готовый перечень
// применять не нужно, из него достаточно выбрать.
//
// Состав спрашивается у платформы через СхемаЗапроса: она знает, какие поля есть у ЭТОЙ
// таблицы в ЭТОЙ конфигурации. Вывод по правилу повторил бы ошибку, которую чиним.
Функция ВиртуальныеТаблицыРегистра(ОбъектМД, ТипОбъекта)
	Виды = Новый Массив;
	Если ТипОбъекта = "AccountingRegister" Тогда
		Виды.Добавить("Обороты");
		Виды.Добавить("ОборотыДтКт");
		Виды.Добавить("Остатки");
		Виды.Добавить("ОстаткиИОбороты");
		Виды.Добавить("ДвиженияССубконто");
	ИначеЕсли ТипОбъекта = "AccumulationRegister" Тогда
		Виды.Добавить("Остатки");
		Виды.Добавить("Обороты");
		Виды.Добавить("ОстаткиИОбороты");
	ИначеЕсли ТипОбъекта = "InformationRegister" Тогда
		Виды.Добавить("СрезПоследних");
		Виды.Добавить("СрезПервых");
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Вид Из Виды Цикл
		ПолноеИмя = ОбъектМД.ПолноеИмя() + "." + Вид;
		Попытка
			Схема = Новый СхемаЗапроса;
			ИсточникТаблицы = Схема.ПакетЗапросов[0].Операторы[0].Источники.Добавить(ПолноеИмя, "Т");
		Исключение
			// Таблицы такого вида у этого регистра нет — это норма, а не ошибка:
			// у непериодического регистра сведений нет СрезПоследних, и т.д.
			Продолжить;
		КонецПопытки;

		Поля = Новый Массив;
		Попытка
			Для Каждого ДоступноеПоле Из ИсточникТаблицы.Источник.ДоступныеПоля Цикл
				Поля.Добавить(Строка(ДоступноеПоле.Имя));
				Если Поля.Количество() >= 60 Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		Исключение
			Продолжить;
		КонецПопытки;
		Если Поля.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		// Имена параметров лежат у ДОСТУПНОЙ таблицы, а не у источника: у
		// ПараметрТаблицыСхемыЗапроса есть только Выражение, имени там нет вовсе
		// (справка вендора). Обращение к Источник.Параметры[].Имя молча давало пустой
		// список — проверено 31.08.2026.
		ИменаПараметров = Новый Массив;
		Попытка
			// ДоступныеТаблицы — свойство ЗАПРОСА ВЫБОРА, а не схемы (справка:
			// ЗапросВыбораСхемыЗапроса.ДоступныеТаблицы). Обращение к Схема.ДоступныеТаблицы
			// роняло чтение в Исключение, и список параметров молча оставался пустым.
			ДоступнаяТаблица = Схема.ПакетЗапросов[0].ДоступныеТаблицы.Найти(ПолноеИмя);
			Если ДоступнаяТаблица <> Неопределено Тогда
				Для Каждого ПараметрТаблицы Из ДоступнаяТаблица.Параметры Цикл
					ИменаПараметров.Добавить(Строка(ПараметрТаблицы.Имя));
				КонецЦикла;
			КонецЕсли;
		Исключение
			// Параметров может не быть.
		КонецПопытки;

		Описание = Новый Структура;
		Описание.Вставить("имя", Вид);
		Описание.Вставить("поля", Поля);
		Описание.Вставить("параметры", ИменаПараметров);
		Результат.Добавить(Описание);
	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// ПланСчетовИсточника — имя плана счетов у регистра бухгалтерии, названного источником.
// Источник приходит как «РегистрБухгалтерии.Хозрасчетный» или с виртуальной таблицей
// «РегистрБухгалтерии.Хозрасчетный.Обороты» — берём вторую часть имени.
Функция ПланСчетовИсточника(Источник)
	Части = СтрРазделить(Источник, ".", Ложь);
	Если Части.Количество() < 2 Или ВРег(Части[0]) <> ВРег("РегистрБухгалтерии") Тогда
		Возврат Неопределено;
	КонецЕсли;
	ОписаниеРегистра = Метаданные.РегистрыБухгалтерии.Найти(Части[1]);
	Если ОписаниеРегистра = Неопределено Или ОписаниеРегистра.ПланСчетов = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ОписаниеРегистра.ПланСчетов.Имя;
КонецФункции

// ПредопределённоеЗначение — ссылка по строке вида «Справочник.Валюты.Рубль». Платформенная
// функция ПредопределенноеЗначение принимает ровно такой формат и сама отвергает выдуманное.
Функция ПредопределённоеЗначение(Описание)
	Возврат ПредопределенноеЗначение(Описание);
КонецФункции

// Ответ об успехе. Поле ok есть всегда — вызывающему не нужно гадать по составу полей.
Функция Успех(Данные)
	Ответ = Новый Структура;
	Ответ.Вставить("ok", Истина);
	Для Каждого Поле Из Данные Цикл
		Ответ.Вставить(Поле.Ключ, Поле.Значение);
	КонецЦикла;
	Возврат ОтветJSON(Ответ, 200);
КонецФункции

// Отказ базы. Код ответа 200 намеренно: см. шапку модуля.
Функция Отказ(Текст, Подробности = "")
	Ответ = Новый Структура;
	Ответ.Вставить("ok", Ложь);
	Ответ.Вставить("error", Текст);
	Ответ.Вставить("detail", Подробности);
	Возврат ОтветJSON(Ответ, 200);
КонецФункции

Функция ОтветJSON(Данные, КодСостояния)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб));
	ЗаписатьJSON(Запись, Данные);
	Тело = Запись.Закрыть();

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции

// Чтение тела POST-запроса как JSON. Возвращает структуру с признаком отказа,
// чтобы обработчик решал сам, а не ловил исключение.
Функция ТелоЗапроса(Запрос)
	Результат = Новый Структура("Отказ, Ошибка, Подробности, Данные", Ложь, "", "", Неопределено);

	Попытка
		Текст = Запрос.ПолучитьТелоКакСтроку("UTF-8");
	Исключение
		Результат.Отказ = Истина;
		Результат.Ошибка = "Тело запроса не прочитано";
		Результат.Подробности = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Если ПустаяСтрока(Текст) Тогда
		Результат.Отказ = Истина;
		Результат.Ошибка = "Тело запроса пусто";
		Результат.Подробности = "ожидался объект JSON";
		Возврат Результат;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Результат.Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Результат.Отказ = Истина;
		Результат.Ошибка = "Тело запроса не разобрано как JSON";
		Результат.Подробности = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;
КонецФункции

// Запрет на всё, кроме чтения. Проверяется ДО обращения к базе: сервис объявлен
// read-only, и это ограничение самого продукта, а не настройка прав пользователя.
Функция ТолькоЧтение(ТекстЗапроса)
	Результат = Новый Структура("Отказ, Ошибка, Подробности", Ложь, "", "");

	// Проверяется КАЖДЫЙ запрос пакета, а не только первый: пакет с временными таблицами —
	// обычное дело, и «ВЫБРАТЬ … ПОМЕСТИТЬ ВТ; ВЫБРАТЬ … ИЗ ВТ; УНИЧТОЖИТЬ ВТ» обязан
	// проходить целиком. ПОМЕСТИТЬ и УНИЧТОЖИТЬ живут внутри сеанса запроса и данных
	// базы не касаются.
	//
	// Оговорка по существу: сам язык запросов 1С писать в базу не умеет вовсе, поэтому
	// проверка защищает не данные, а вызывающего — от попытки прислать сюда код вместо
	// запроса и получить невнятную ошибку платформы вместо понятного отказа.
	Разрешённые = СтрРазделить("ВЫБРАТЬ,SELECT,УНИЧТОЖИТЬ,DROP", ",");

	Для Каждого ЧастьПакета Из СтрРазделить(ТекстЗапроса, ";", Ложь) Цикл
		Часть = СокрЛП(ВРег(ЧастьПакета));
		Если ПустаяСтрока(Часть) Тогда
			Продолжить;
		КонецЕсли;

		Годится = Ложь;
		Для Каждого Глагол Из Разрешённые Цикл
			Если СтрНачинаетсяС(Часть, Глагол) Тогда
				Годится = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если Не Годится Тогда
			Результат.Отказ = Истина;
			Результат.Ошибка = "Запрос отклонён: сервис только читает";
			Результат.Подробности = "часть пакета начинается не с ВЫБРАТЬ и не с УНИЧТОЖИТЬ: "
				+ Лев(Часть, 40);
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Выполнение запроса и ответ таблицей. Общая часть query и register: обе отдают
// колонки и строки, и обе обязаны сказать, сколько строк осталось за пределом.
Функция ВыполнитьЗапросИОтветить(ТекстЗапроса, Параметры, Предел, Смещение = 0)
	Попытка
		ЗапросОбъект = Новый Запрос(ТекстЗапроса);
		ЗаполнитьПараметры(ЗапросОбъект, Параметры);
		Таблица = ЗапросОбъект.Выполнить().Выгрузить();
	Исключение
		Возврат Отказ("Запрос не выполнен", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Колонки = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;

	// Смещение отсчитывается по строкам результата. Порядок строк задаёт сам запрос:
	// без УПОРЯДОЧИТЬ платформа его не гарантирует, и страницы поедут — об этом
	// предупреждает описание инструмента, а не молчаливая подстановка сортировки.
	Строки = Новый Массив;
	Индекс = Смещение;
	Пока Индекс < Таблица.Количество() И Строки.Количество() < Предел Цикл
		СтрокаТаблицы = Таблица[Индекс];
		Значения = Новый Структура;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Значения.Вставить(Колонка.Имя, ПредставлениеЗначения(СтрокаТаблицы[Колонка.Имя]));
		КонецЦикла;
		Строки.Добавить(Значения);
		Индекс = Индекс + 1;
	КонецЦикла;

	Данные = Новый Структура;
	Данные.Вставить("колонки", Колонки);
	Данные.Вставить("строк", Строки.Количество());
	Данные.Вставить("всегоСтрок", Таблица.Количество());
	Данные.Вставить("смещение", Смещение);
	Данные.Вставить("следующееСмещение", Индекс);
	Данные.Вставить("естьЕщё", Индекс < Таблица.Количество());
	Данные.Вставить("обрезано", Индекс < Таблица.Количество());
	Данные.Вставить("строки", Строки);
	Возврат Успех(Данные);
КонецФункции

// Сборка текста запроса к виртуальной таблице регистра.
Функция ТекстЗапросаПоРегистру(ИмяРегистра, Вид, Разрезы, Показатели, Тело)
	Результат = Новый Структура("Отказ, Ошибка, Подробности, Текст, Параметры",
		Ложь, "", "", "", Новый Структура);

	Аргументы = "";
	Если Вид = "Остатки" Тогда
		Период = ДатаИзТела(Тело, "period");
		Если ЗначениеЗаполнено(Период) Тогда
			Аргументы = "&Период";
			Результат.Параметры.Вставить("Период", Период);
		КонецЕсли;
	Иначе
		Начало = ДатаИзТела(Тело, "start");
		Конец = ДатаИзТела(Тело, "end");
		Если Не ЗначениеЗаполнено(Начало) Или Не ЗначениеЗаполнено(Конец) Тогда
			Результат.Отказ = Истина;
			Результат.Ошибка = "Период оборотов не задан";
			Результат.Подробности = "для kind=" + Вид + " нужны поля start и end";
			Возврат Результат;
		КонецЕсли;
		Аргументы = "&Начало, &Конец";
		Результат.Параметры.Вставить("Начало", Начало);
		Результат.Параметры.Вставить("Конец", Конец);
	КонецЕсли;

	Условие = ПолеТела(Тело, "where", "");
	Если Не ПустаяСтрока(Условие) Тогда
		Аргументы = Аргументы + ?(ПустаяСтрока(Аргументы), ", , ", ", ") + Условие;
	КонецЕсли;

	Поля = Новый Массив;
	Для Каждого Разрез Из Разрезы Цикл
		Поля.Добавить("Итоги." + Разрез + " КАК " + Разрез);
	КонецЦикла;
	Для Каждого Показатель Из Показатели Цикл
		Поля.Добавить("СУММА(Итоги." + Показатель + ") КАК " + Показатель);
	КонецЦикла;

	Текст = "ВЫБРАТЬ " + СтрСоединить(Поля, ", ")
		+ " ИЗ РегистрНакопления." + ИмяРегистра + "." + Вид + "(" + Аргументы + ") КАК Итоги";

	Если Разрезы.Количество() > 0 Тогда
		Группировки = Новый Массив;
		Для Каждого Разрез Из Разрезы Цикл
			Группировки.Добавить("Итоги." + Разрез);
		КонецЦикла;
		Текст = Текст + " СГРУППИРОВАТЬ ПО " + СтрСоединить(Группировки, ", ");
	КонецЕсли;

	Результат.Текст = Текст;
	Возврат Результат;
КонецФункции

// Показатели бухгалтерских итогов, когда вызывающий их не назвал.
//
// Здесь умолчание уместно (в отличие от регистров накопления): имена ресурсов у
// регистра бухгалтерии стандартные и одинаковые во всех конфигурациях.
Функция ПоказателиПоУмолчанию(Вид)
	Показатели = Новый Массив;
	Если Вид = "Остатки" Тогда
		Показатели.Добавить("СуммаОстатокДт");
		Показатели.Добавить("СуммаОстатокКт");
	ИначеЕсли Вид = "Обороты" Тогда
		Показатели.Добавить("СуммаОборотДт");
		Показатели.Добавить("СуммаОборотКт");
	Иначе
		Показатели.Добавить("СуммаНачальныйОстатокДт");
		Показатели.Добавить("СуммаНачальныйОстатокКт");
		Показатели.Добавить("СуммаОборотДт");
		Показатели.Добавить("СуммаОборотКт");
		Показатели.Добавить("СуммаКонечныйОстатокДт");
		Показатели.Добавить("СуммаКонечныйОстатокКт");
	КонецЕсли;
	Возврат Показатели;
КонецФункции

Процедура ЗаполнитьПараметры(ЗапросОбъект, Параметры)
	Для Каждого Параметр Из Параметры Цикл
		ЗапросОбъект.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
КонецПроцедуры

// Значение результата в вид, пригодный для JSON.
//
// Ссылка отдаётся объектом с представлением, типом и идентификатором: одного
// представления мало — по нему нельзя ни отобрать, ни отличить пустую ссылку от NULL.
Функция ПредставлениеЗначения(Значение)
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss");
	ИначеЕсли ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("Строка") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Строка(Значение);
	КонецЕсли;

	ОбъектМД = Метаданные.НайтиПоТипу(ТипЗначения);
	Если ОбъектМД <> Неопределено Тогда
		Если Значение = Неопределено Или НЕ ЗначениеЗаполнено(Значение) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Ссылка = Новый Структура;
		Ссылка.Вставить("представление", Строка(Значение));
		Ссылка.Вставить("тип", АнглийскаяНотация(ОбъектМД.ПолноеИмя()));
		Попытка
			Ссылка.Вставить("идентификатор", Строка(Значение.УникальныйИдентификатор()));
		Исключение
			Ссылка.Вставить("идентификатор", "");
		КонецПопытки;
		Возврат Ссылка;
	КонецЕсли;

	Возврат Строка(Значение);
КонецФункции

Функция ПараметрыИзТела(Тело)
	Параметры = Новый Структура;
	Значения = ПолеТела(Тело, "parameters", Неопределено);
	Если Значения = Неопределено Тогда
		Возврат Параметры;
	КонецЕсли;

	Для Каждого Параметр Из Значения Цикл
		Параметры.Вставить(Параметр.Ключ, ЗначениеПараметра(Параметр.Значение));
	КонецЦикла;
	Возврат Параметры;
КонецФункции

// Значения параметров приходят из JSON. Два случая требуют распознавания, иначе отбор
// молча не находит ничего: дата (её узнаём по формату) и ссылка (её описывают объектом
// с типом и идентификатором — строка на месте ссылки даёт либо ноль строк, либо ошибку
// сравнения несовместимых типов).
Функция ЗначениеПараметра(Значение)
	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Соответствие") Или ТипЗначения = Тип("Структура") Тогда
		Возврат ЗначениеСсылочногоПараметра(Значение);
	КонецЕсли;

	Если ТипЗначения = Тип("Массив") Тогда
		// Список для «В (&Параметр)»: каждый элемент разбирается по тем же правилам.
		Элементы = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Элементы.Добавить(ЗначениеПараметра(Элемент));
		КонецЦикла;
		Возврат Элементы;
	КонецЕсли;

	Если ТипЗначения <> Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	Дата = ДатаИзСтроки(Значение);
	Возврат ?(ЗначениеЗаполнено(Дата), Дата, Значение);
КонецФункции

// ОписаниеЗначенияПараметра — обратная к ЗначениеСсылочногоПараметра: ссылка → описание,
// которое переживёт передачу по JSON и вернётся ссылкой при выполнении запроса.
//
// Нужна потому, что сборка и выполнение запроса — РАЗНЫЕ вызовы. Всё, что построитель
// вычислил (ссылку счёта по коду, предопределённое значение), между ними существует только
// в виде JSON. Строка(Ссылка) для этого не годится: она даёт представление, по которому
// ссылку не восстановить, а подстановка представления в параметр не ломает запрос — она
// молча обнуляет его выборку.
//
// Нессылочные значения (число, дата, строка) возвращаются как есть: их JSON переживает.
Функция ОписаниеЗначенияПараметра(Значение)
	Метаданные_ = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
	Если Метаданные_ = Неопределено Тогда
		Возврат Значение;
	КонецЕсли;

	ПолноеИмя = СтрРазделить(Метаданные_.ПолноеИмя(), ".");
	Если ПолноеИмя.Количество() < 2 Тогда
		Возврат Значение;
	КонецЕсли;

	Нотация = НотацияПоКатегории(ПолноеИмя[0]);
	Если ПустаяСтрока(Нотация) Тогда
		Возврат Значение;
	КонецЕсли;

	Описание = Новый Структура;
	Описание.Вставить("тип", Нотация + "." + ПолноеИмя[1]);
	Описание.Вставить("представление", Строка(Значение));

	// У перечислений нет идентификаторов — они предопределены и называются именем.
	Если Нотация = "EnumRef" Тогда
		Описание.Вставить("значение", ИмяЗначенияПеречисления(Значение, ПолноеИмя[1]));
		Возврат Описание;
	КонецЕсли;

	Попытка
		Описание.Вставить("идентификатор", Строка(Значение.УникальныйИдентификатор()));
	Исключение
		Возврат Значение;
	КонецПопытки;
	Возврат Описание;
КонецФункции

// НотацияПоКатегории — «ПланыСчетов» → «ChartOfAccountsRef». Обратная МенеджерПоНотации;
// список держится согласованным с ней, иначе значение уедет наружу неописанным.
Функция НотацияПоКатегории(Категория)
	Если Категория = "Справочник" Тогда
		Возврат "CatalogRef";
	ИначеЕсли Категория = "Документ" Тогда
		Возврат "DocumentRef";
	ИначеЕсли Категория = "Перечисление" Тогда
		Возврат "EnumRef";
	ИначеЕсли Категория = "ПланВидовХарактеристик" Тогда
		Возврат "ChartOfCharacteristicTypesRef";
	ИначеЕсли Категория = "ПланСчетов" Тогда
		Возврат "ChartOfAccountsRef";
	ИначеЕсли Категория = "ПланВидовРасчета" Тогда
		Возврат "ChartOfCalculationTypesRef";
	КонецЕсли;
	Возврат "";
КонецФункции

// ИмяЗначенияПеречисления — ссылка перечисления → имя её значения в метаданных.
Функция ИмяЗначенияПеречисления(Ссылка, ИмяПеречисления)
	Попытка
		Перечисление = Перечисления[ИмяПеречисления];
		Для Каждого ЗначениеПеречисления Из Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления Цикл
			Если Перечисление[ЗначениеПеречисления.Имя] = Ссылка Тогда
				Возврат ЗначениеПеречисления.Имя;
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Имя не нашлось — вернём пустое, описание всё равно несёт тип и представление.
	КонецПопытки;
	Возврат "";
КонецФункции

// Ссылка из описания {"тип": "CatalogRef.Номенклатура", "идентификатор": "..."}.
//
// Для перечисления вместо идентификатора называется имя значения: у перечислений нет
// идентификаторов, они предопределены.
Функция ЗначениеСсылочногоПараметра(Описание)
	ИмяТипа = ПолеТела(Описание, "тип", "");
	Идентификатор = ПолеТела(Описание, "идентификатор", "");
	ИмяЗначения = ПолеТела(Описание, "значение", "");

	Если ПустаяСтрока(ИмяТипа) Тогда
		Возврат Описание;
	КонецЕсли;

	Части = СтрРазделить(ИмяТипа, ".");
	Если Части.Количество() < 2 Тогда
		Возврат Описание;
	КонецЕсли;

	Менеджер = МенеджерПоНотации(Части[0], Части[1]);
	Если Менеджер = Неопределено Тогда
		Возврат Описание;
	КонецЕсли;

	Попытка
		Если Части[0] = "EnumRef" Тогда
			Возврат Менеджер[ИмяЗначения];
		КонецЕсли;
		Возврат Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
	Исключение
		Возврат Описание;
	КонецПопытки;
КонецФункции

// Менеджер объекта по английской нотации типа: «CatalogRef» + «Номенклатура».
Функция МенеджерПоНотации(Нотация, Имя)
	Попытка
		Если Нотация = "CatalogRef" Тогда
			Возврат Справочники[Имя];
		ИначеЕсли Нотация = "DocumentRef" Тогда
			Возврат Документы[Имя];
		ИначеЕсли Нотация = "EnumRef" Тогда
			Возврат Перечисления[Имя];
		ИначеЕсли Нотация = "ChartOfCharacteristicTypesRef" Тогда
			Возврат ПланыВидовХарактеристик[Имя];
		ИначеЕсли Нотация = "ChartOfAccountsRef" Тогда
			Возврат ПланыСчетов[Имя];
		ИначеЕсли Нотация = "ChartOfCalculationTypesRef" Тогда
			Возврат ПланыВидовРасчета[Имя];
		ИначеЕсли Нотация = "ExchangePlanRef" Тогда
			Возврат ПланыОбмена[Имя];
		ИначеЕсли Нотация = "BusinessProcessRef" Тогда
			Возврат БизнесПроцессы[Имя];
		ИначеЕсли Нотация = "TaskRef" Тогда
			Возврат Задачи[Имя];
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

// ПериодичностьИзТела — периодичность виртуальной таблицы, только из известного перечня.
//
// Значение подставляется В ТЕКСТ запроса, поэтому произвольную строку брать нельзя ни при
// каких обстоятельствах: это прямая инъекция в язык запросов. Незнакомое слово отвергается
// с перечнем допустимых, а не подставляется «как есть» в надежде, что платформа разберётся.
Функция ПериодичностьИзТела(Тело, Ключ)
	Значение = ПолеТела(Тело, Ключ, Неопределено);
	Если Значение = Неопределено Или Не ЗначениеЗаполнено(Строка(Значение)) Тогда
		Возврат "";
	КонецЕсли;
	Допустимые = Новый Соответствие;
	Для Каждого Слово Из СтрРазделить("День,Неделя,Декада,Месяц,Квартал,Полугодие,Год,Регистратор,Период,Авто", ",") Цикл
		Допустимые.Вставить(ВРег(Слово), Слово);
	КонецЦикла;
	Найдено = Допустимые.Получить(ВРег(СокрЛП(Строка(Значение))));
	Если Найдено = Неопределено Тогда
		Возврат "?" + СокрЛП(Строка(Значение));
	КонецЕсли;
	Возврат Найдено;
КонецФункции

Функция ЧислоИзТела(Тело, Ключ, Умолчание)
	Значение = ПолеТела(Тело, Ключ, Неопределено);
	Если Значение = Неопределено Тогда
		Возврат Умолчание;
	КонецЕсли;
	Попытка
		Число = Число(Значение);
	Исключение
		Возврат Умолчание;
	КонецПопытки;
	Возврат ?(Число > 1000, 1000, ?(Число <= 0, Умолчание, Число));
КонецФункции

Функция МассивИзТела(Тело, Ключ)
	Значение = ПолеТела(Тело, Ключ, Неопределено);
	Если Значение = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;
	Результат = Новый Массив;
	Результат.Добавить(Строка(Значение));
	Возврат Результат;
КонецФункции

Функция ДатаИзТела(Тело, Ключ)
	Возврат ДатаИзСтроки(ПолеТела(Тело, Ключ, ""));
КонецФункции

// Разбор даты ISO 8601 (и её укороченной формы «ГГГГ-ММ-ДД»).
Функция ДатаИзСтроки(Текст)
	Если ПустаяСтрока(Текст) Тогда
		Возврат '00010101';
	КонецЕсли;

	Попытка
		Очищенный = СтрЗаменить(СтрЗаменить(СтрЗаменить(СокрЛП(Текст), "-", ""), ":", ""), "T", "");
		Очищенный = СтрЗаменить(Очищенный, " ", "");
		Если СтрДлина(Очищенный) = 8 Тогда
			Очищенный = Очищенный + "000000";
		КонецЕсли;
		Возврат Дата(Очищенный);
	Исключение
		Возврат '00010101';
	КонецПопытки;
КонецФункции

Функция УровеньЖурнала(Имя)
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("Ошибка", УровеньЖурналаРегистрации.Ошибка);
	Соответствие.Вставить("Предупреждение", УровеньЖурналаРегистрации.Предупреждение);
	Соответствие.Вставить("Информация", УровеньЖурналаРегистрации.Информация);
	Соответствие.Вставить("Примечание", УровеньЖурналаРегистрации.Примечание);
	Возврат Соответствие.Получить(Имя);
КонецФункции

// Поле разобранного тела. JSON читается в Соответствие намеренно: ключи приходят
// от вызывающего и не обязаны быть допустимыми именами свойств структуры.
Функция ПолеТела(Тело, Ключ, Умолчание)
	Если Тело = Неопределено Тогда
		Возврат Умолчание;
	КонецЕсли;
	Значение = Тело.Получить(Ключ);
	Возврат ?(Значение = Неопределено, Умолчание, Значение);
КонецФункции

Функция ПараметрЗапроса(Запрос, Имя)
	Значение = Запрос.ПараметрыЗапроса.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Значение);
КонецФункции

Функция ВерсияРасширения()
	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		Если Расширение.Имя = "GTData" Тогда
			Возврат Расширение.Версия;
		КонецЕсли;
	КонецЦикла;
	Возврат "неизвестна";
КонецФункции

Функция СтрокаПлатформы()
	Сведения = Новый СистемнаяИнформация;
	Возврат Сведения.ВерсияПриложения;
КонецФункции

// Категории метаданных, которые сервис показывает. Список закрытый и осознанный:
// показывается то, из чего берутся данные, а не всё дерево конфигурации.
Функция КатегорииМетаданных()
	Категории = Новый Структура;
	Категории.Вставить("Справочники", Метаданные.Справочники);
	Категории.Вставить("Документы", Метаданные.Документы);
	Категории.Вставить("Перечисления", Метаданные.Перечисления);
	Категории.Вставить("РегистрыСведений", Метаданные.РегистрыСведений);
	Категории.Вставить("РегистрыНакопления", Метаданные.РегистрыНакопления);
	Категории.Вставить("РегистрыБухгалтерии", Метаданные.РегистрыБухгалтерии);
	Категории.Вставить("РегистрыРасчета", Метаданные.РегистрыРасчета);
	Категории.Вставить("ПланыСчетов", Метаданные.ПланыСчетов);
	Категории.Вставить("ПланыВидовХарактеристик", Метаданные.ПланыВидовХарактеристик);
	Категории.Вставить("ПланыВидовРасчета", Метаданные.ПланыВидовРасчета);
	Категории.Вставить("ПланыОбмена", Метаданные.ПланыОбмена);
	Категории.Вставить("БизнесПроцессы", Метаданные.БизнесПроцессы);
	Категории.Вставить("Задачи", Метаданные.Задачи);
	Категории.Вставить("Константы", Метаданные.Константы);
	Категории.Вставить("Обработки", Метаданные.Обработки);
	Категории.Вставить("Отчеты", Метаданные.Отчеты);
	Категории.Вставить("Подсистемы", Метаданные.Подсистемы);
	Категории.Вставить("ОпределяемыеТипы", Метаданные.ОпределяемыеТипы);
	Возврат Категории;
КонецФункции

// Соответствие типа объекта коллекции метаданных. Имена типов английские,
// как их называет вызывающий (Catalog, Document, …).
Функция КоллекцияПоТипу(ТипОбъекта)
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("Catalog", Метаданные.Справочники);
	Соответствие.Вставить("Document", Метаданные.Документы);
	Соответствие.Вставить("Enum", Метаданные.Перечисления);
	Соответствие.Вставить("InformationRegister", Метаданные.РегистрыСведений);
	Соответствие.Вставить("AccumulationRegister", Метаданные.РегистрыНакопления);
	Соответствие.Вставить("AccountingRegister", Метаданные.РегистрыБухгалтерии);
	Соответствие.Вставить("CalculationRegister", Метаданные.РегистрыРасчета);
	Соответствие.Вставить("ChartOfAccounts", Метаданные.ПланыСчетов);
	Соответствие.Вставить("ChartOfCharacteristicTypes", Метаданные.ПланыВидовХарактеристик);
	Соответствие.Вставить("ChartOfCalculationTypes", Метаданные.ПланыВидовРасчета);
	Соответствие.Вставить("ExchangePlan", Метаданные.ПланыОбмена);
	Соответствие.Вставить("BusinessProcess", Метаданные.БизнесПроцессы);
	Соответствие.Вставить("Task", Метаданные.Задачи);
	Соответствие.Вставить("Constant", Метаданные.Константы);
	Соответствие.Вставить("DataProcessor", Метаданные.Обработки);
	Соответствие.Вставить("Report", Метаданные.Отчеты);
	Соответствие.Вставить("DefinedType", Метаданные.ОпределяемыеТипы);
	Соответствие.Вставить("Subsystem", Метаданные.Подсистемы);
	Возврат Соответствие.Получить(ТипОбъекта);
КонецФункции

// Состав типов определяемого типа. Без него DefinedType в реквизите объекта —
// тупик: видно имя, не видно, что за ним стоит.
Функция СоставОпределяемогоТипа(ОбъектМД)
	Если Не ЕстьСвойство(ОбъектМД, "Тип") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Представление = ПредставлениеТипа(ОбъектМД.Тип);
	Возврат ?(ПустаяСтрока(Представление), Неопределено, СтрРазделить(Представление, " | "));
КонецФункции

// Состав подсистемы: какие объекты в неё входят и какие подсистемы вложены.
Функция СоставПодсистемы(ОбъектМД)
	Если Не ЕстьСвойство(ОбъектМД, "Состав") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Состав = Новый Массив;
	Для Каждого Элемент Из ОбъектМД.Состав Цикл
		Состав.Добавить(Элемент.ПолноеИмя());
	КонецЦикла;
	Возврат ?(Состав.Количество() = 0, Неопределено, Состав);
КонецФункции

Функция ВложенныеПодсистемы(ОбъектМД)
	Если Не ЕстьСвойство(ОбъектМД, "Подсистемы") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Вложенные = Новый Массив;
	Для Каждого Подсистема Из ОбъектМД.Подсистемы Цикл
		Описание = Новый Структура;
		Описание.Вставить("имя", Подсистема.Имя);
		Описание.Вставить("синоним", Подсистема.Синоним);
		Описание.Вставить("состав", СоставПодсистемы(Подсистема));
		Описание.Вставить("подсистемы", ВложенныеПодсистемы(Подсистема));
		Вложенные.Добавить(Описание);
	КонецЦикла;
	Возврат ?(Вложенные.Количество() = 0, Неопределено, Вложенные);
КонецФункции

// Описание набора полей объекта (реквизиты, измерения, ресурсы).
// Типы называются явно строкой вида CatalogRef.Номенклатура — проза здесь не годится:
// по ней нельзя написать запрос.
Функция ОписаниеПолей(ОбъектМД, ИмяКоллекции)
	Если Не ЕстьСвойство(ОбъектМД, ИмяКоллекции) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Поля = Новый Массив;
	Для Каждого Поле Из ОбъектМД[ИмяКоллекции] Цикл
		Описание = Новый Структура;
		Описание.Вставить("имя", Поле.Имя);
		Описание.Вставить("синоним", Поле.Синоним);
		Описание.Вставить("тип", ПредставлениеТипа(Поле.Тип));
		// У регистра бухгалтерии небалансовое измерение или ресурс раздваивается в таблице
		// запроса на «имяДт» и «имяКт». Без этого признака имя из ответа нельзя подставить
		// в запрос: «ВалютаДт» есть, «Валюта» нет, и отказ приходит уже на разборе.
		Если ЕстьСвойство(Поле, "Балансовый") Тогда
			Описание.Вставить("балансовый", Поле.Балансовый);
		КонецЕсли;
		Поля.Добавить(Описание);
	КонецЦикла;
	Возврат ?(Поля.Количество() = 0, Неопределено, Поля);
КонецФункции

// Стандартные поля — те, что платформа заводит сама и которых нет ни в одной из коллекций
// Реквизиты / Измерения / Ресурсы: Период, Регистратор, Активность, НомерСтроки у регистров,
// Номер, Дата, Проведен у документов, Код и Наименование у справочников. Инструмент велит звать
// object перед запросом — и до этой правки умалчивал ровно о тех полях, по которым запрос и
// пишется. Список берётся у платформы, а не задаётся здесь перечислением: перечисление устарело
// бы молча на первой же конфигурации, где состав другой.
Функция СтандартныеПоля(ОбъектМД)
	Если Не ЕстьСвойство(ОбъектМД, "СтандартныеРеквизиты") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Поля = Новый Массив;
	Для Каждого Реквизит Из ОбъектМД.СтандартныеРеквизиты Цикл
		Описание = Новый Структура;
		Описание.Вставить("имя", Реквизит.Имя);
		Описание.Вставить("синоним", Реквизит.Синоним);
		Описание.Вставить("тип", ПредставлениеТипа(Реквизит.Тип));
		Поля.Добавить(Описание);
	КонецЦикла;
	Возврат ?(Поля.Количество() = 0, Неопределено, Поля);
КонецФункции

// Регистр бухгалтерии устроен не так, как прочие: имя поля в запросе зависит от СВОЙСТВ
// регистра, а не от имени в метаданных. При корреспонденции счёт раздваивается на СчетДт и
// СчетКт, всякое небалансовое измерение и ресурс — на «имяДт» и «имяКт». Знать это по ответу
// инструмента было нельзя, и имена приходилось угадывать.
Функция ОсобенностиРегистраБухгалтерии(ОбъектМД, ТипОбъекта)
	Если ТипОбъекта <> "AccountingRegister" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = Новый Структура;

	Корреспонденция = Ложь;
	Если ЕстьСвойство(ОбъектМД, "Корреспонденция") Тогда
		Корреспонденция = ОбъектМД.Корреспонденция;
	КонецЕсли;
	Данные.Вставить("корреспонденция", Корреспонденция);

	ПоляСчета = Новый Массив;
	Если Корреспонденция Тогда
		ПоляСчета.Добавить("СчетДт");
		ПоляСчета.Добавить("СчетКт");
	Иначе
		ПоляСчета.Добавить("Счет");
	КонецЕсли;
	Данные.Вставить("поляСчета", ПоляСчета);

	Если ЕстьСвойство(ОбъектМД, "ПланСчетов") Тогда
		ПланСчетов = ОбъектМД.ПланСчетов;
		Данные.Вставить("планСчетов", ПланСчетов.Имя);
		Если ЕстьСвойство(ПланСчетов, "МаксКоличествоСубконто") Тогда
			Данные.Вставить("максСубконто", ПланСчетов.МаксКоличествоСубконто);
		КонецЕсли;
	КонецЕсли;

	Возврат Данные;
КонецФункции

Функция ОписаниеТабличныхЧастей(ОбъектМД)
	Если Не ЕстьСвойство(ОбъектМД, "ТабличныеЧасти") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Часть Из ОбъектМД.ТабличныеЧасти Цикл
		Описание = Новый Структура;
		Описание.Вставить("имя", Часть.Имя);
		Описание.Вставить("синоним", Часть.Синоним);
		Описание.Вставить("реквизиты", ОписаниеПолей(Часть, "Реквизиты"));
		Части.Добавить(Описание);
	КонецЦикла;
	Возврат ?(Части.Количество() = 0, Неопределено, Части);
КонецФункции

Функция ЗначенияПеречисления(ОбъектМД)
	Если Не ЕстьСвойство(ОбъектМД, "ЗначенияПеречисления") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значения = Новый Массив;
	Для Каждого Значение Из ОбъектМД.ЗначенияПеречисления Цикл
		Описание = Новый Структура;
		Описание.Вставить("имя", Значение.Имя);
		Описание.Вставить("синоним", Значение.Синоним);
		Значения.Добавить(Описание);
	КонецЦикла;
	Возврат ?(Значения.Количество() = 0, Неопределено, Значения);
КонецФункции

// Представление описания типов строкой: Number(15,2), String(100), CatalogRef.X, …
//
// Тип обязан называться так, чтобы по нему можно было написать запрос. Проза
// («ссылка на номенклатуру») для этого не годится, поэтому ссылочные типы отдаются
// в английской нотации, а примитивные — с квалификаторами.
Функция ПредставлениеТипа(ОписаниеТипов)
	Если ОписаниеТипов = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Имена = Новый Массив;
	Для Каждого Тип Из ОписаниеТипов.Типы() Цикл
		Имена.Добавить(ИмяОдногоТипа(Тип, ОписаниеТипов));
	КонецЦикла;

	// Широкий составной тип перечислять поимённо нельзя: Регистратор регистра бухгалтерии —
	// это 118 типов, реквизит СторнируемыйДокумент — около 400, и один такой ответ вытесняет
	// из контекста агента всё остальное. Перечень при этом бесполезен: писать запрос по полю
	// «ссылка на документ любого вида» приходится одинаково, каким бы ни был список. Отдаём
	// сводку по видам объектов — она отвечает на тот же вопрос и стоит одной строки.
	Если Имена.Количество() > ПорогПеречисленияТипов() Тогда
		Возврат СводкаСоставногоТипа(Имена);
	КонецЕсли;
	Возврат СтрСоединить(Имена, " | ");
КонецФункции

// Порог вынесен отдельно, чтобы его было видно: 8 — это столько типов, сколько ещё читается
// глазом в одной строке. Реквизиты с двумя-тремя типами (частый случай) остаются как были.
Функция ПорогПеречисленияТипов()
	Возврат 8;
КонецФункции

// Сводка вида «составной: 118 типов — DocumentRef (104), CatalogRef (12), EnumRef (2)».
Функция СводкаСоставногоТипа(Имена)
	ПоВидам = Новый Соответствие;
	Порядок = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Точка = СтрНайти(Имя, ".");
		Вид = ?(Точка > 0, Лев(Имя, Точка - 1), Имя);
		Текущее = ПоВидам.Получить(Вид);
		Если Текущее = Неопределено Тогда
			Порядок.Добавить(Вид);
			Текущее = 0;
		КонецЕсли;
		ПоВидам.Вставить(Вид, Текущее + 1);
	КонецЦикла;

	Части = Новый Массив;
	Для Каждого Вид Из Порядок Цикл
		Части.Добавить(Вид + " (" + Формат(ПоВидам.Получить(Вид), "ЧГ=0") + ")");
	КонецЦикла;

	Возврат "составной: " + Формат(Имена.Количество(), "ЧГ=0") + " типов — "
		+ СтрСоединить(Части, ", ");
КонецФункции

// Имя одного типа. Квалификаторы берутся из описания: без них Number и String
// ничего не говорят о том, что поле выдержит.
Функция ИмяОдногоТипа(Тип, ОписаниеТипов)
	Если Тип = Тип("Число") Тогда
		Квалификаторы = ОписаниеТипов.КвалификаторыЧисла;
		Если Квалификаторы = Неопределено Тогда
			Возврат "Number";
		КонецЕсли;
		Возврат "Number(" + Квалификаторы.Разрядность
			+ "," + Квалификаторы.РазрядностьДробнойЧасти + ")";

	ИначеЕсли Тип = Тип("Строка") Тогда
		Квалификаторы = ОписаниеТипов.КвалификаторыСтроки;
		Если Квалификаторы = Неопределено Или Квалификаторы.Длина = 0 Тогда
			Возврат "String";
		КонецЕсли;
		Возврат "String(" + Квалификаторы.Длина + ")";

	ИначеЕсли Тип = Тип("Дата") Тогда
		Возврат "Date";

	ИначеЕсли Тип = Тип("Булево") Тогда
		Возврат "Boolean";

	ИначеЕсли Тип = Тип("УникальныйИдентификатор") Тогда
		Возврат "UUID";

	ИначеЕсли Тип = Тип("ХранилищеЗначения") Тогда
		Возврат "ValueStorage";
	КонецЕсли;

	// Ссылочный тип: имя берётся у самого объекта метаданных, а не собирается по строке.
	ОбъектМД = Метаданные.НайтиПоТипу(Тип);
	Если ОбъектМД <> Неопределено Тогда
		Возврат АнглийскаяНотация(ОбъектМД.ПолноеИмя());
	КонецЕсли;

	Возврат Строка(Тип);
КонецФункции

// Русское полное имя объекта метаданных → английская нотация ссылочного типа:
// «Справочник.Номенклатура» → «CatalogRef.Номенклатура».
//
// Разбираются только русские префиксы, и это сознательная граница продукта, а не пробел:
// продукт рассчитан на русскоязычные конфигурации (см. README, раздел о границах).
// Незнакомый префикс возвращается как есть — сломаться такой объект не должен.
Функция АнглийскаяНотация(ПолноеИмя)
	Части = СтрРазделить(ПолноеИмя, ".");
	Если Части.Количество() < 2 Тогда
		Возврат ПолноеИмя;
	КонецЕсли;

	Префиксы = Новый Соответствие;
	Префиксы.Вставить("Справочник", "CatalogRef");
	Префиксы.Вставить("Документ", "DocumentRef");
	Префиксы.Вставить("Перечисление", "EnumRef");
	Префиксы.Вставить("ПланВидовХарактеристик", "ChartOfCharacteristicTypesRef");
	Префиксы.Вставить("ПланСчетов", "ChartOfAccountsRef");
	Префиксы.Вставить("ПланВидовРасчета", "ChartOfCalculationTypesRef");
	Префиксы.Вставить("ПланОбмена", "ExchangePlanRef");
	Префиксы.Вставить("БизнесПроцесс", "BusinessProcessRef");
	Префиксы.Вставить("Задача", "TaskRef");
	Префиксы.Вставить("ТочкаМаршрутаБизнесПроцесса", "BusinessProcessRoutePointRef");

	Префикс = Префиксы.Получить(Части[0]);
	Если Префикс = Неопределено Тогда
		Возврат ПолноеИмя;
	КонецЕсли;
	Возврат Префикс + "." + Части[1];
КонецФункции

Процедура ДобавитьЕслиЕсть(Данные, Ключ, Значение)
	Если Значение <> Неопределено Тогда
		Данные.Вставить(Ключ, Значение);
	КонецЕсли;
КонецПроцедуры

// Проверка наличия свойства у объекта метаданных: у разных объектов набор коллекций
// разный, и обращение к отсутствующей роняет обработчик целиком.
Функция ЕстьСвойство(Объект, ИмяСвойства)
	Попытка
		Проверка = Объект[ИмяСвойства];
		Возврат Проверка <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Один запрос пакета. Пакет разнороден: кроме запросов выбора в нём живёт УНИЧТОЖИТЬ,
// у которого нет ни операторов, ни колонок, и обращение к ним роняет разбор целиком.
Функция ОписаниеЗапросаПакета(ЗапросПакета, Номер, ВсеТаблицы, ВременныеТаблицы)
	Описание = Новый Структура;
	Если Номер >= 0 Тогда
		Описание.Вставить("номер", Номер + 1);
	КонецЕсли;

	Если Не ЕстьСвойство(ЗапросПакета, "Операторы") Тогда
		// Запрос уничтожения временной таблицы.
		Описание.Вставить("вид", "уничтожение");
		ДобавитьЕслиЕсть(Описание, "таблица", ЗначениеИлиНеопределено(ЗапросПакета, "ИмяТаблицы"));
		Возврат Описание;
	КонецЕсли;

	Описание.Вставить("вид", "выборка");

	ТаблицаПомещения = ЗначениеИлиНеопределено(ЗапросПакета, "ТаблицаДляПомещения");
	Если ТаблицаПомещения <> Неопределено И Не ПустаяСтрока(ТаблицаПомещения) Тогда
		Описание.Вставить("помещаетВ", ТаблицаПомещения);
		Если ВременныеТаблицы.Найти(ТаблицаПомещения) = Неопределено Тогда
			ВременныеТаблицы.Добавить(ТаблицаПомещения);
		КонецЕсли;
	КонецЕсли;

	// Колонки — единственное место, где псевдоним результата связан с выражением:
	// у выбираемых полей оператора псевдонима нет вовсе.
	Колонки = Новый Массив;
	Для Каждого Колонка Из ЗапросПакета.Колонки Цикл
		Стр = Новый Структура;
		Стр.Вставить("псевдоним", Колонка.Псевдоним);
		Выражения = Новый Массив;
		Для Каждого Выражение Из Колонка.Поля Цикл
			Выражения.Добавить(ТекстВыражения(Выражение));
		КонецЦикла;
		Если Выражения.Количество() = 1 Тогда
			Стр.Вставить("выражение", Выражения[0]);
		Иначе
			// Несколько выражений на колонку — это ОБЪЕДИНИТЬ: по одному на каждый оператор.
			Стр.Вставить("выражения", Выражения);
		КонецЕсли;
		Колонки.Добавить(Стр);
	КонецЦикла;
	Описание.Вставить("колонки", Колонки);

	Операторы = Новый Массив;
	Для Каждого Оператор Из ЗапросПакета.Операторы Цикл
		Операторы.Добавить(ОписаниеОператора(Оператор, ВсеТаблицы, ВременныеТаблицы));
	КонецЦикла;
	// Несколько операторов означают ОБЪЕДИНИТЬ, и молчать об этом нельзя: читающий
	// решит, что запрос читает одну таблицу, тогда как их несколько.
	Если Операторы.Количество() > 1 Тогда
		Описание.Вставить("объединение", Операторы.Количество());
	КонецЕсли;
	Описание.Вставить("операторы", Операторы);

	Порядок = ОписаниеПорядка(ЗапросПакета);
	Если Порядок.Количество() > 0 Тогда
		Описание.Вставить("порядок", Порядок);
	КонецЕсли;

	Итоги = ОписаниеИтогов(ЗапросПакета);
	Если Итоги <> Неопределено Тогда
		Описание.Вставить("итоги", Итоги);
	КонецЕсли;

	Возврат Описание;
КонецФункции

// Оператор ВЫБРАТЬ: источники, поля, отбор, группировка.
Функция ОписаниеОператора(Оператор, ВсеТаблицы, ВременныеТаблицы)
	Описание = Новый Структура;

	Источники = Новый Массив;
	Для Каждого Источник Из Оператор.Источники Цикл
		Источники.Добавить(ОписаниеИсточника(Источник, ВсеТаблицы, ВременныеТаблицы));
	КонецЦикла;
	Описание.Вставить("источники", Источники);

	Поля = Новый Массив;
	Для Каждого Поле Из Оператор.ВыбираемыеПоля Цикл
		Поля.Добавить(ТекстВыражения(Поле));
	КонецЦикла;
	Описание.Вставить("поля", Поля);

	Отбор = СобратьВыражения(Оператор, "Отбор");
	Если Отбор.Количество() > 0 Тогда
		Описание.Вставить("отбор", Отбор);
	КонецЕсли;

	Группировка = СобратьВыражения(Оператор, "Группировка");
	Если Группировка.Количество() > 0 Тогда
		Описание.Вставить("группировка", Группировка);
	КонецЕсли;

	Если ЗначениеИлиНеопределено(Оператор, "ВыбиратьРазличные") = Истина Тогда
		Описание.Вставить("различные", Истина);
	КонецЕсли;

	Первые = ЗначениеИлиНеопределено(Оператор, "КоличествоПолучаемыхЗаписей");
	Если Первые <> Неопределено Тогда
		Описание.Вставить("первые", Первые);
	КонецЕсли;

	Возврат Описание;
КонецФункции

// Источник данных: таблица базы, временная таблица или вложенный запрос.
Функция ОписаниеИсточника(Источник, ВсеТаблицы, ВременныеТаблицы)
	Описание = Новый Структура;
	Внутренний = Источник.Источник;

	Если ЕстьСвойство(Внутренний, "Запрос") Тогда
		// Вложенный запрос — разбирается тем же кодом, что и запрос пакета.
		Описание.Вставить("вид", "вложенныйЗапрос");
		ДобавитьЕслиЕсть(Описание, "псевдоним", ЗначениеИлиНеопределено(Внутренний, "Псевдоним"));
		Описание.Вставить("запрос",
			ОписаниеЗапросаПакета(Внутренний.Запрос, -1, ВсеТаблицы, ВременныеТаблицы));
	Иначе
		ИмяТаблицы = ЗначениеИлиНеопределено(Внутренний, "ИмяТаблицы");
		// Временная таблица от обычной по типу неотличима — только по имени, объявленному
		// выше по пакету через ПОМЕСТИТЬ. Поэтому вид определяется списком, а не свойством.
		Если ИмяТаблицы <> Неопределено И ВременныеТаблицы.Найти(ИмяТаблицы) <> Неопределено Тогда
			Описание.Вставить("вид", "временнаяТаблица");
		ИначеЕсли ИмяТаблицы <> Неопределено И СтрНачинаетсяС(ИмяТаблицы, "&") Тогда
			// Источником может быть параметр (ИЗ &Ссылки КАК Т — таблица значений,
			// переданная снаружи). В перечень таблиц БАЗЫ он не попадает: его там нет.
			Описание.Вставить("вид", "параметрИсточник");
		Иначе
			Описание.Вставить("вид", "таблица");
			Если ИмяТаблицы <> Неопределено И Не ПустаяСтрока(ИмяТаблицы) Тогда
				ВсеТаблицы.Вставить(ИмяТаблицы, Истина);
			КонецЕсли;
		КонецЕсли;
		ДобавитьЕслиЕсть(Описание, "таблица", ИмяТаблицы);
		ДобавитьЕслиЕсть(Описание, "псевдоним", ЗначениеИлиНеопределено(Внутренний, "Псевдоним"));

		// Параметры виртуальной таблицы: период, условие отбора. Именно в них прячется
		// половина смысла запроса по регистру, и в списке полей их не видно.
		Если ЕстьСвойство(Внутренний, "Параметры") Тогда
			ПараметрыТаблицы = Новый Массив;
			Для Каждого Параметр Из Внутренний.Параметры Цикл
				Выражение = ЗначениеИлиНеопределено(Параметр, "Выражение");
				Если Выражение <> Неопределено Тогда
					ПараметрыТаблицы.Добавить(ТекстВыражения(Выражение));
				КонецЕсли;
			КонецЦикла;
			Если ПараметрыТаблицы.Количество() > 0 Тогда
				Описание.Вставить("параметрыТаблицы", ПараметрыТаблицы);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Соединения = Новый Массив;
	Если ЕстьСвойство(Источник, "Соединения") Тогда
		Для Каждого Соединение Из Источник.Соединения Цикл
			Стр = Новый Структура;
			ДобавитьЕслиЕсть(Стр, "тип", СтрокаИлиНеопределено(Соединение, "ТипСоединения"));
			Условие = ЗначениеИлиНеопределено(Соединение, "Условие");
			Если Условие <> Неопределено Тогда
				Стр.Вставить("условие", ТекстВыражения(Условие));
			КонецЕсли;
			Соединения.Добавить(Стр);
		КонецЦикла;
	КонецЕсли;
	Если Соединения.Количество() > 0 Тогда
		Описание.Вставить("соединения", Соединения);
	КонецЕсли;

	Возврат Описание;
КонецФункции

// УПОРЯДОЧИТЬ ПО. Текст берётся у колонки, а не у выражения порядка: у самого выражения
// порядка читаемого текста нет — только направление.
Функция ОписаниеПорядка(ЗапросПакета)
	Результат = Новый Массив;
	Если Не ЕстьСвойство(ЗапросПакета, "Порядок") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Элемент Из ЗапросПакета.Порядок Цикл
		Стр = Новый Структура;
		Колонка = ЗначениеИлиНеопределено(Элемент, "Элемент");
		Если Колонка <> Неопределено Тогда
			ДобавитьЕслиЕсть(Стр, "поле", ЗначениеИлиНеопределено(Колонка, "Псевдоним"));
		КонецЕсли;
		ДобавитьЕслиЕсть(Стр, "направление", СтрокаИлиНеопределено(Элемент, "Направление"));
		Результат.Добавить(Стр);
	КонецЦикла;

	Возврат Результат;
КонецФункции

// ИТОГИ ПО. Отдаётся только при наличии: у большинства запросов итогов нет.
Функция ОписаниеИтогов(ЗапросПакета)
	Выражения = СобратьВыражения(ЗапросПакета, "ВыраженияИтогов");
	Контрольные = СобратьВыражения(ЗапросПакета, "КонтрольныеТочкиИтогов");
	Общие = ЗначениеИлиНеопределено(ЗапросПакета, "ОбщиеИтоги");

	Если Выражения.Количество() = 0 И Контрольные.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Если Выражения.Количество() > 0 Тогда
		Результат.Вставить("показатели", Выражения);
	КонецЕсли;
	Если Контрольные.Количество() > 0 Тогда
		Результат.Вставить("поГруппировкам", Контрольные);
	КонецЕсли;
	Если Общие = Истина Тогда
		Результат.Вставить("общиеИтоги", Истина);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Коллекция выражений в массив текстов. Коллекции может не быть — это не ошибка.
Функция СобратьВыражения(Объект, ИмяКоллекции)
	Результат = Новый Массив;
	Если Не ЕстьСвойство(Объект, ИмяКоллекции) Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Элемент Из Объект[ИмяКоллекции] Цикл
		Результат.Добавить(ТекстВыражения(Элемент));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Текст выражения схемы запроса.
//
// Свойств у выражения нет ни одного — ни Выражение, ни Псевдоним, ни Представление():
// платформа отдаёт текст только приведением к строке. Проверено на 8.3.27; поэтому здесь
// Строка(), а не обращение к свойству, которое выглядело бы честнее и не работало бы.
Функция ТекстВыражения(Выражение)
	Попытка
		Возврат СокрЛП(Строка(Выражение));
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// Свойство объекта схемы или Неопределено, если его нет. Набор свойств у объектов схемы
// разный, и обращение к отсутствующему роняет обработчик.
Функция ЗначениеИлиНеопределено(Объект, ИмяСвойства)
	Попытка
		Возврат Объект[ИмяСвойства];
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// То же, но сразу строкой: типы вроде ТипСоединенияСхемыЗапроса в JSON не сериализуются.
Функция СтрокаИлиНеопределено(Объект, ИмяСвойства)
	Значение = ЗначениеИлиНеопределено(Объект, ИмяСвойства);
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
КонецФункции

// Описание поля в выражение. Поле задаётся либо строкой ("Номенклатура", "Ссылка.Дата"),
// либо структурой {функция, поле, как} — так, чтобы имена функций не пришлось знать
// и чтобы скобки расставляла не вызывающая сторона.
Функция ВыражениеПоля(Описание, ПсевдонимТаблицы, ИзвестныеПсевдонимы = Неопределено)
	Результат = Новый Структура("Отказ, Ошибка, Выражение, Псевдоним", Ложь, "", "", "");

	Если ТипЗнч(Описание) = Тип("Строка") Тогда
		Результат.Выражение = ДополнитьПсевдонимом(Описание, ПсевдонимТаблицы, ИзвестныеПсевдонимы);
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Описание) <> Тип("Структура") И ТипЗнч(Описание) <> Тип("Соответствие") Тогда
		Результат.Отказ = Истина;
		Результат.Ошибка = "поле задаётся строкой или объектом {функция, поле, как}";
		Возврат Результат;
	КонецЕсли;

	ИмяПоля = ЗначениеКлюча(Описание, "поле");
	Выражение = ЗначениеКлюча(Описание, "выражение");
	ИмяФункции = ЗначениеКлюча(Описание, "функция");
	Период = ЗначениеКлюча(Описание, "период");
	Результат.Псевдоним = ЗначениеКлюча(Описание, "как");

	Если Не ПустаяСтрока(Выражение) Тогда
		// Готовое выражение вставляется как есть: агрегаты по нескольким полям, ВЫБОР,
		// арифметика — всё, для чего пары «функция + поле» не хватает.
		Результат.Выражение = Выражение;
		Возврат Результат;
	КонецЕсли;

	// Счёт строк: КОЛИЧЕСТВО без поля или с полем «*» — это КОЛИЧЕСТВО(*). Без этого
	// построитель отвечал «поле не заполнено», и модель, лишённая текста руками гейтом,
	// сочиняла помесячную разбивку под известный итог (прогон 27.08.2026, К1).
	Если ВРег(ИмяФункции) = "КОЛИЧЕСТВО" И (ПустаяСтрока(ИмяПоля) Или СокрЛП(ИмяПоля) = "*") Тогда
		Результат.Выражение = "КОЛИЧЕСТВО(*)";
		Возврат Результат;
	КонецЕсли;
	Если ПустаяСтрока(ИмяПоля) Тогда
		Результат.Отказ = Истина;
		Результат.Ошибка = "у поля не заполнены ни «поле», ни «выражение» (для счёта строк — функция КОЛИЧЕСТВО без поля)";
		Возврат Результат;
	КонецЕсли;

	Текст = ДополнитьПсевдонимом(ИмяПоля, ПсевдонимТаблицы, ИзвестныеПсевдонимы);
	Если Не ПустаяСтрока(ИмяФункции) Тогда
		// Периодные функции двухаргументные: НАЧАЛОПЕРИОДА(Дата, МЕСЯЦ). Склейка вида
		// «функция(поле)» для них синтаксически верна, и платформа МОЛЧА достраивает
		// пропущенный аргумент до ДЕНЬ — запрос собирается с ok=true, колонка называется
		// «Месяц», а группировка идёт по дню. Тихая подмена хуже отказа: ответ приходит,
		// он правдоподобен и он неверен (прогон 27.08.2026, К1 — 20 строк по дням вместо
		// 5 по месяцам). Поэтому период обязателен и называется явно.
		Если ПериоднаяФункция(ИмяФункции) Тогда
			Если ПустаяСтрока(Период) Тогда
				Результат.Отказ = Истина;
				Результат.Ошибка = "функции " + ВРег(ИмяФункции) + " нужен период: добавьте «период»"
					+ " со значением МИНУТА, ЧАС, ДЕНЬ, НЕДЕЛЯ, ДЕКАДА, МЕСЯЦ, КВАРТАЛ, ПОЛУГОДИЕ или ГОД."
					+ " Без него платформа молча возьмёт ДЕНЬ, и колонка «"
					+ ?(ПустаяСтрока(Результат.Псевдоним), "Месяц", Результат.Псевдоним)
					+ "» окажется дневной";
				Возврат Результат;
			КонецЕсли;
			Если Не ДопустимыйПериод(Период) Тогда
				Результат.Отказ = Истина;
				Результат.Ошибка = "период «" + Период + "» платформе неизвестен:"
					+ " допустимы МИНУТА, ЧАС, ДЕНЬ, НЕДЕЛЯ, ДЕКАДА, МЕСЯЦ, КВАРТАЛ, ПОЛУГОДИЕ, ГОД";
				Возврат Результат;
			КонецЕсли;
			Текст = ВРег(ИмяФункции) + "(" + Текст + ", " + ВРег(СокрЛП(Период)) + ")";
		ИначеЕсли Не ПустаяСтрока(Период) Тогда
			Результат.Отказ = Истина;
			Результат.Ошибка = "«период» задан при функции " + ВРег(ИмяФункции)
				+ ", которая периода не принимает: он нужен только НАЧАЛОПЕРИОДА и КОНЕЦПЕРИОДА";
			Возврат Результат;
		Иначе
			Текст = ВРег(ИмяФункции) + "(" + Текст + ")";
		КонецЕсли;
	ИначеЕсли Не ПустаяСтрока(Период) Тогда
		Результат.Отказ = Истина;
		Результат.Ошибка = "«период» задан без «функции»: период нужен функциям НАЧАЛОПЕРИОДА и КОНЕЦПЕРИОДА";
		Возврат Результат;
	КонецЕсли;

	Результат.Выражение = Текст;
	Возврат Результат;
КонецФункции

// Функции периода — единственные двухаргументные среди тех, что задаются парой
// «функция + поле». Остальные (СУММА, ГОД, КОЛИЧЕСТВО) берут один аргумент, и склейка
// «функция(поле)» для них полна.
Функция ПериоднаяФункция(ИмяФункции)
	Имя = ВРег(СокрЛП(ИмяФункции));
	Возврат Имя = "НАЧАЛОПЕРИОДА" Или Имя = "КОНЕЦПЕРИОДА";
КонецФункции

// Периоды платформы. Проверяются здесь, а не отдаются схеме на откуп: опечатка в периоде
// даёт отказ платформы про «поле не принято», из которого не видно, что виноват период.
Функция ДопустимыйПериод(Период)
	Значение = ВРег(СокрЛП(Период));
	Известные = "МИНУТА,ЧАС,ДЕНЬ,НЕДЕЛЯ,ДЕКАДА,МЕСЯЦ,КВАРТАЛ,ПОЛУГОДИЕ,ГОД";
	Возврат СтрНайти("," + Известные + ",", "," + Значение + ",") > 0;
КонецФункции

// Дописать псевдоним таблицы к имени поля, если вызывающий его не указал.
//
// Пишущий структуру думает про поля таблицы, а не про псевдонимы: «Номенклатура», а не
// «Тов.Номенклатура». Схема же требует полное обращение. Дополняется только простое имя
// поля (возможно, через точку) — выражение с пробелами, скобками, операторами или
// параметром не трогается: там псевдоним либо уже есть, либо не нужен.
Функция ДополнитьПсевдонимом(Текст, ПсевдонимТаблицы, ИзвестныеПсевдонимы = Неопределено)
	Значение = СокрЛП(Текст);
	Если ПустаяСтрока(Значение) Или ПустаяСтрока(ПсевдонимТаблицы) Тогда
		Возврат Значение;
	КонецЕсли;

	// Признак составного выражения: что угодно, кроме букв, цифр, подчёркивания и точки.
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Позиция, 1);
		Если Символ = "." Или Символ = "_" Тогда
			Продолжить;
		КонецЕсли;
		Код = КодСимвола(Символ);
		ЭтоБуква = (Код >= 65 И Код <= 90) Или (Код >= 97 И Код <= 122)
			Или (Код >= 1040 И Код <= 1103) Или Код = 1025 Или Код = 1105;
		ЭтоЦифра = Код >= 48 И Код <= 57;
		Если Не ЭтоБуква И Не ЭтоЦифра Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;

	// Уже начинается с псевдонима — второй раз не дописываем. Проверяются ВСЕ псевдонимы
	// запроса, а не только основной: поле присоединённой таблицы принадлежит ей, и приписать
	// ему чужой псевдоним — гарантированный отказ «поле не найдено».
	Если СтрНачинаетсяС(ВРег(Значение), ВРег(ПсевдонимТаблицы) + ".") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ИзвестныеПсевдонимы <> Неопределено Тогда
		Для Каждого ИзвестныйПсевдоним Из ИзвестныеПсевдонимы Цикл
			Если Не ПустаяСтрока(ИзвестныйПсевдоним)
				И СтрНачинаетсяС(ВРег(Значение), ВРег(ИзвестныйПсевдоним) + ".") Тогда
				Возврат Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат ПсевдонимТаблицы + "." + Значение;
КонецФункции

// Псевдоним таблицы по её имени, когда вызывающий не задал свой: последняя часть имени.
// Для Документ.РеализацияТоваровУслуг.Товары это «Товары», для Справочник.Номенклатура —
// «Номенклатура». Читается в тексте так же, как написал бы человек.
Функция ПсевдонимПоУмолчанию(ИмяТаблицы)
	Части = СтрРазделить(ИмяТаблицы, ".", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат "Т";
	КонецЕсли;
	Возврат Части[Части.Количество() - 1];
КонецФункции

// Значение ключа структуры или соответствия строкой; пусто, если ключа нет.
Функция ЗначениеКлюча(Описание, Ключ)
	Попытка
		Если ТипЗнч(Описание) = Тип("Структура") Тогда
			Значение = Неопределено;
			Если Не Описание.Свойство(Ключ, Значение) Тогда
				Возврат "";
			КонецЕсли;
		Иначе
			Значение = Описание.Получить(Ключ);
		КонецЕсли;
		Если Значение = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат СокрЛП(Строка(Значение));
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// Отказ сборки. Отдельно от общего Отказ, потому что здесь всегда известно, ЧТО именно
// не принято: без этого «Поле не найдено» приходится соотносить с описанием на глаз.
Функция ОтказСборки(Причина, Фрагмент, ОшибкаПлатформы)
	Возврат Отказ(Причина + ": " + Фрагмент, ОшибкаПлатформы
		+ ". Состав полей объекта отдаёт инструмент object, перечень объектов — metadata");
КонецФункции

#КонецОбласти
