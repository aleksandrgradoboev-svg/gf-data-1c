bin/
build/ext/
build/ext-*/
# Расширение кладёт сюда сборка — это артефакт. Игнорируется СОДЕРЖИМОЕ, а не сам
# каталог: git не заходит внутрь игнорируемого каталога, и тогда исключение ниже
# не работает. Каталог обязан существовать — без него go:embed не компилируется
# и свежий клон не собирается вовсе.
internal/installer/extension/*
!internal/installer/extension/РАСШИРЕНИЕ-НЕ-СОБРАНО.txt
*.exe
build/out/
