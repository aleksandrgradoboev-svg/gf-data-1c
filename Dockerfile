# syntax=docker/dockerfile:1
#
# Образ gf-data-1c: сервер отвечает агенту по MCP, ходит в базы 1С по HTTP.
#
# Зачем он. Stdio требует, чтобы клиент запускал бинарь сам, — на своей машине это верно
# и так и работает. HTTP нужен там, где команду выполнить нечем: клиент живёт в контейнере
# или в вебе и процессов не поднимает. Ради этого случая у сервера есть -http — он
# принимает адрес прослушивания строкой.
#
# Чего в образе НЕТ намеренно:
#
#   - расширения 1С, встроенного в бинарь. Оно раскладывается из описания скриптом
#     build-extension.ps1, которому нужен инструментарий сборки объектов 1С — в Linux-образ
#     это не едет. Установщик (-install, -export-extension) в таком бинаре честно откажет
#     и назовёт команду сборки; ставить расширение надо готовым dist/GTData.cfe. Ответы на
#     данные от этого не страдают: установка — разовое действие на машине с платформой;
#   - базы справки платформы. Она весит десятки мегабайт и обновляется отдельно от сервера,
#     поэтому монтируется томом и указывается переменной GTDATA_KB. Без неё инструмент
#     syntax отдаёт отказ с объяснением, а работа по данным не блокируется.

# ── Сборка ───────────────────────────────────────────────────────────────
#
# Образ полный, а не -alpine: там musl, а нам он не нужен — cgo в проекте нет вовсе
# (драйвер SQLite взят чистый на Go, modernc), поэтому бинарь и так статический.
# Версия Go берётся из go.mod, чтобы образ не разошёлся с проектом молча.
FROM golang:1.25-bookworm AS build

WORKDIR /build

# Зависимости отдельным слоем: они меняются реже кода, и слой переиспользуется.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .

# CGO_ENABLED=0 явно: иначе на машине с gcc линковка может уехать в динамическую,
# и бинарь не запустится в debian-slim без нужных библиотек. Отказ был бы при первом
# запуске контейнера, а не при сборке, — то есть у того, кто образ уже забрал.
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /gfdata ./cmd/gfdata

# ── Запуск ───────────────────────────────────────────────────────────────
FROM debian:bookworm-slim

LABEL org.opencontainers.image.title="gf-data-1c" \
      org.opencontainers.image.description="MCP-сервер к данным информационных баз 1С:Предприятие, только чтение" \
      org.opencontainers.image.source="https://github.com/aleksandrgradoboev-svg/gf-data-1c" \
      org.opencontainers.image.licenses="MIT"

# Сертификаты нужны, если база опубликована по https. bash — для проверки живости
# в compose: она стучится в сервер через /dev/tcp, а это возможность bash, и в dash
# её нет вовсе. Ставить ради одной строки curl не хочется.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates bash \
 && rm -rf /var/lib/apt/lists/*

# Пользователь без прав: сервер только читает базы по HTTP и никуда не пишет, кроме
# своего каталога данных. Root ему не нужен ни для чего.
RUN useradd --system --uid 10001 --user-group --create-home gfdata

COPY --from=build /gfdata /usr/local/bin/gfdata

# Реестр баз и журнал сервер держит в профиле пользователя. Каталог создаётся заранее
# и отдаётся владельцу: иначе первая же регистрация базы упрётся в права, а выглядеть
# это будет как отказ реестра.
ENV HOME=/home/gfdata
RUN mkdir -p /home/gfdata/.config/gt-data-1c /home/gfdata/.cache/gt-data-1c \
 && chown -R gfdata:gfdata /home/gfdata

USER gfdata
EXPOSE 9077

# Адрес 0.0.0.0 обязателен, и это не небрежность: 127.0.0.1 внутри контейнера — его
# собственная петля, снаружи по ней не достучаться даже через опубликованный порт.
# Наружу выносит строка ports в compose, и там по умолчанию петля ХОСТА.
#
# Токен НЕ задан по умолчанию намеренно: пустой -token означает «проверки нет», и
# зашитый в образ пароль был бы хуже его отсутствия — он выглядит защитой, не будучи ею.
# Сервер сам предупреждает в журнал, что слушает нелокальный адрес без токена.
ENTRYPOINT ["gfdata"]
CMD ["-http", "0.0.0.0:9077"]
